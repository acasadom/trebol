Trebol [title: "Screen tests of cached and refresh"]

bikes: []
asked: 0
serve [
    GET "/api/bikes" [set 'asked asked + 1  copy/deep bikes]
    POST "/api/bikes" [append bikes make map! reduce ['name body/name]  #(ok: true)]
]

"cached"
[
    clear bikes  append bikes #(name: "Road")
    see "Road"  see "1 bikes"
]
; a post to the same path asks again, and what reads it follows
[
    clear bikes  append bikes #(name: "Road")
    see "1 bikes"
    type "Name" "City"  click "Add"
    see "City"  see "2 bikes"
]
[
    clear bikes  asked: 0
    see "0 bikes"
    append bikes #(name: "Gravel")
    see/not "Gravel"
    click "Again"
    see "Gravel"  see "1 bikes"
    asked = 2
]
"an answer with no body"
[
    serve [DELETE "/api/bikes/1" [reply 204 none]]
    "" = fetch/with "/api/bikes/1" [method: 'DELETE]
]
