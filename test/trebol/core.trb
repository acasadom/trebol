Trebol [
    title: "Core language tests"
    ; Format: a string names a group; each block after it is one test and
    ; must evaluate to true. Any core implementation runs this same file.
]

"arithmetic"
[1 + 2 * 3 = 9]
[7 / 2 = 3.5]
[6 / 3 == 2]
[-7 // 2 = -1]
[$0.10 + $0.20 == $0.30]
[error? try [9223372036854775807 + 1]]
[1:00 + 0:30 = 1:30]
[3x4 + 1 = 4x5]
[7 = max 3 7]
["a" = min "b" "a"]
[5 = abs -5]

"round"
[13.0 == round 12.5]
[-13.0 == round -12.5]
[7 == round 7]
[3.14 == round/to 3.14159 0.01]
[2.68 == round/to 2.675 0.01]
[12 == round/to 12.345 1]
[15 == round/to 17 5]
[2.0 == round/even 2.5]
[4.0 == round/even 3.5]
[12.0 == round/down 12.9]
[-2.0 == round/floor -1.5]
[2.0 == round/ceiling 1.1]
[2.0 == round/half-down 2.5]
[-2.0 == round/half-ceiling -2.5]
[$15.13 == round/to $15.125 $0.01]
[$2.63 == round/to $2.625 0.01]
[$15.00 == round $15.125]
[13% == round 12.5%]
[1:30:46 == round 1:30:45.6]
[1:30 == round/to 1:37 0:15]
[error? try [round/to 1 0]]

"date parts"
[d: 14-Nov-2026/10:30 6 = d/weekday]
[d: 14-Nov-2026/10:30 318 = d/yearday]
[d: 14-Nov-2026/10:30 14-Nov-2026 == d/date]
[d: 14-Nov-2026/10:30 all [10 = d/hour 30 = d/minute 0 = d/second]]
[d: 14-Nov-2026 none? d/hour]
[d: 9-Nov-2026 1 = d/weekday]
[d: 15-Nov-2026 7 = d/weekday]

"reflection"
[f: func ["Doc." a [integer!] /r b] [a] ["Doc." a [integer!] /r b] = spec-of :f]
[f: func [a] [a + 1] [a + 1] = body-of :f]
[f: func [a /r b /local c] [a] [a /r b /local c] = words-of :f]
[[a b] = words-of func [a b] []]
[[x /local y] = words-of function [x] [y: x]]
[none? body-of :append]
[block? spec-of :append]
[(spec-of :+) = spec-of :add]
[[a b] = words-of make object! [a: 1 b: 2]]
[[1 2] = values-of make object! [a: 1 b: 2]]
[[a b] = words-of #(a: 1 b: 2)]
[[1 2] = values-of #(a: 1 b: 2)]
[f: func [a] [a] s: spec-of :f append s 'x [a] = spec-of :f]
["func [a] [a + 1]" = mold func [a] [a + 1]]
["#[function!]" = mold/all func [a] [a]]
["func [a /local b] [b: a]" = mold function [a] [b: a]]
["func [a] [a + 1]" = mold function [a] [a + 1]]
[o: make object! [w: 'red p: 'a/b n: none b: [x y]]  (mold o) = "make object! [^/    w: 'red^/    p: 'a/b^/    n: none^/    b: [x y]^/]"]
[o: make object! [w: 'red p: 'a/b]  o2: do mold o  all [o2/w = 'red  o2/p = 'a/b]]

"comparison"
[1 = 1.0]
[not 1 == 1.0]
["Hello" = "hello"]
[#"a" = #"A"]
['abc = first [abc:]]
[[1 2] = [1 2]]
[1-Jan-2026 < 2-Jan-2026]
[2 >= 2]
[1 <> 2]

"logic"
[true and true]
[not (true and false)]
[false or true]
[6 and 3 = 2]
[none? all [1 none 3]]
[7 = any [none false 7]]

"words and paths"
[x: 10 x = 10]
[b: [a 1 b 2] b/b = 2]
[b: [10 20 30] n: 2 b/:n = 20]
[o: make object! [p: make object! [q: 5]] o/p/q = 5]
[o: make object! [v: 1] o/v: 2 o/v = 2]
[m: make map! [k 1] m/k: 2 m/k = 2]
[m: make map! [] none? m/missing]
[d: 30-Oct-2026 d/month = 10]

"functions"
[f: func [a b] [a + b] (f 1 2) = 3]
[f: func [n] [either n < 2 [n] [(f n - 1) + f n - 2]] (f 15) = 610]
[f: func [/opt v] [either opt [v] [0]] all [(f) = 0 (f/opt 5) = 5]]
[mk: func [n] [does [n]] a: mk 1 b: mk 2 all [(a) = 1 (b) = 2]]
[f: func [x [integer!]] [x] error? try [f "no"]]
[f: does [return 1 2] (f) = 1]

"objects"
[o: context [a: 1 get-a: does [a]] (o/get-a) = 1]
[p: context [n: 1 f: does [n]] q: make p [n: 2] all [(p/f) = 1 (q/f) = 2]]
[o: context [a: 1] (length? o) = 1]
[p: context [b: [] s: ""] q: make p [] append q/b 1 append q/s "x" all [empty? p/b empty? p/s]]

"loops"
[n: 0 loop 4 [n: n + 1] n = 4]
[s: 0 repeat i 10 [s: s + i] s = 55]
[out: copy "" foreach c "abc" [append out c] out = "abc"]
[n: 0 while [n < 100] [n: n + 1 if n = 7 [break]] n = 7]
[(loop 3 [break/return 9]) = 9]
[s: 0 repeat i 4 [if i = 2 [continue] s: s + i] s = 8]

"errors"
[e: try [1 / 0] e/type = 'math]
[e: try [undefined-thing] e/id = 'no-value]
[e: try [do make error! "custom"] e/message = "custom"]
[none? attempt [1 / 0]]
[(catch [throw 3]) = 3]
[(catch/name [throw/name 4 'k] 'k) = 4]
[e: try [cause-error 'user 'out-of-stock ["No" 'chain "left"]]  all [e/type = 'user  e/id = 'out-of-stock  e/message = "No chain left"  e/where = 'cause-error]]
[e: try [first 5]  all [e/where = 'first  e/near = [first 5]]]
[e: try [cause-error 'math 'zero-divide "x"]  e/message = "x"]

"evaluation"
[(do [1 + 1]) = 2]
[(do "2 * 3") = 6]
[(reduce [1 + 1 2 * 2]) = [2 4]]
[(quote (1 + 2)) = quote (1 + 2)]
[c: 0 case/all [true [c: c + 1] true [c: c + 1]] c = 2]
[(switch 'b [a [1] b [2]]) = 2]
[b: [1 + 1 2 * 3]  all [2 = do/next b 'b  b = [2 * 3]  6 = do/next b 'b  tail? b]]
[b: []  all [unset? do/next b 'r  same? b r]]
[all [1 = do/next 1 'r  none? r]]
[all [1 = do/next "1 2" 'r  r = [2]]]

"binding"
[o: make object! [t: 2]  r: [t * 3]  all [6 = do bind r o  r = [t * 3]]]
[o: make object! [t: 2]  r: [t]  c: bind/copy r o  all [2 = do c  not same? r c  error? try [do r]]]
[o: make object! [t: 2]  same? o context? in o 't]
[none? context? to word! "t"]
[o: make object! [t: 2]  same? o bound? in o 't]
[f: func [n] [context? 'n]  2 = get in f 2 'n]
[u: 1  unset 'u  not value? 'u]
[u: 1 v: 2  unset [u v]  not any [value? 'u value? 'v]]

"same?"
[a: [1 2]  same? a a]
[not same? [1 2] [1 2]]
[a: [1 2]  not same? a next a]
[o: make object! [x: 1]  same? o o]
[not same? make object! [x: 1] make object! [x: 1]]
[same? 1 1]
[not same? 1 2]

"conversions and parts found by the tutorial"
[(to decimal! 1:30) = 5400.0]
[(to integer! 0:01:30.5) = 90]
[(to decimal! 0:00:00.25) = 0.25]
[x: ada@shop.example  all [x/user = "ada"  x/host = "shop.example"]]
[e: try [x: ada@shop.example  x/name]  e/message = "cannot pick name in an email!"]

"bytes as text, hex and checksums"
[(enbase "Hello") = "SGVsbG8="]
[(enbase/base #{CAFE} 16) = "CAFE"]
[(enbase/base #{0F} 2) = "00001111"]
[(debase "SGVsbG8=") = #{48656C6C6F}]
[(to string! debase "SGVsbG8=") = "Hello"]
[(debase/base "cafe" 16) = #{CAFE}]
[error? try [debase/base "xyz" 16]]
[error? try [enbase/base "a" 8]]
[(to-hex 255) = #00000000000000FF]
[(to-hex/size 255 2) = #FF]
[(to-hex -1) = #FFFFFFFFFFFFFFFF]
[(to-hex 1.2.255) = #0102FF]
[(dehex "a%20b%2Fc") = "a b/c"]
[(dehex "caf%C3%A9") = "café"]
[(form dehex http://x/a%20b) = "http://x/a b"]
[(enhex "a b/ñ?&=") = "a%20b%2F%C3%B1%3F%26%3D"]
[(enhex "a-b_c.d~e*f!'()") = "a-b_c.d~e*f!'()"]
[(enhex "€") = "%E2%82%AC"]
[(enhex/uri "a b") = "a+b"]
[(enhex to url! "http://x.es/a?q=1&r=[2]#f") = to url! "http://x.es/a?q=1&r=%5B2%5D#f"]
[(dehex enhex "café / ñ") = "café / ñ"]
[file? enhex %a.txt]
[(to-query #(q: "café ñ" page: 2)) = "q=caf%C3%A9%20%C3%B1&page=2"]
[(to-query [q "x" n 3 skip #[none]]) = "q=x&n=3"]
[(to-query #(tags: ["a" "b"])) = "tags=a&tags=b"]
[(to-query #(day: 1-Jan-2026 price: $3.50 "my key" "a&b")) = "day=2026-01-01&price=3.50&my%20key=a%26b"]
[(to-query make object! [a: 1]) = "a=1"]
[(to-query #()) = ""]
[error? try [to-query [1 2]]]
[(load-query "q=caf%C3%A9+x&page=2") = #(q: "café x" page: "2")]
[(load-query "tags=a&tags=b&flag") = #(tags: ["a" "b"] flag: "")]
[(load-query "?my%20key=1") = #("my key" "1")]
[(load-query http://x.es/p?a=1&b=2#top) = #(a: "1" b: "2")]
[(load-query http://x.es/p) = #()]
[q: #(q: "a&b=ñ" n: "1") (load-query to-query q) = q]
[(checksum "" 'md5) = #{D41D8CD98F00B204E9800998ECF8427E}]
[(checksum "abc" 'md5) = #{900150983CD24FB0D6963F7D28E17F72}]
[(checksum "abc" 'sha1) = #{A9993E364706816ABA3E25717850C26C9CD0D89D}]
[(checksum "abc" 'sha256) = #{BA7816BF8F01CFEA414140DE5DAE2223B00361A396177A9CB410FF61F20015AD}]
[(checksum "The quick brown fox jumps over the lazy dog" 'crc32) = 1095738169]
[(checksum "Wikipedia" 'adler32) = 300286872]
[error? try [checksum "a" 'nope]]

"ajoin, comment, forever, default"
[(ajoin ["a" 1 + 1 'b]) = "a2b"]
[(reform [1 + 1 "a" [b c]]) = "2 a b c"]
[(reform "x") = "x"]
[(reform 3) = "3"]
[(reform []) = ""]
[unset? comment [anything here]]
[n: 0  forever [n: n + 1  if n = 3 [break]]  n = 3]
[(forever [break/return 5]) = 5]
[unset 'dflt  default dflt 1  dflt = 1]
[dflt: 2  default dflt 1  dflt = 2]
[dflt: none  default dflt 3  dflt = 3]

"json leaves functions out"
[(to-json make object! [a: 1 f: does [2]]) = {{"a":1}}]
[(to-json reduce [1 :add]) = "[1,null]"]

"decimals show 15 digits and compare as R3"
[(mold 0.1 + 0.2) = "0.3"]
[(mold/all 0.1 + 0.2) = "0.30000000000000004"]
[(mold 10% + 5%) = "15%"]
[(mold 1.0 / 3) = "0.333333333333333"]
[(load mold/all 1.0 / 3) == (1.0 / 3)]
[0.1 + 0.2 = 0.3]
[not (0.1 + 0.2 == 0.3)]
[not (0.3 = 0.30000001)]
[1 = 1.0]

"each call has its own literal blocks"
[f: func [] [b: [x y] append b 'z  b]  all [(f) = [x y z]  (f) = [x y z]]]
[f: func [n] [b: [
    a
    b
] insert b n  b]  all [(mold f 1) = "[1^/    a^/    b^/]"  (mold f 2) = "[2^/    a^/    b^/]"]]
[f: func [] [b: [3 1 2] sort b  reverse b  b]  all [(f) = [3 2 1]  (f) = [3 2 1]]]
