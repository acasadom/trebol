Trebol [
    title: "Core language tests"
    ; Format: a string names a group; each block after it is one test and
    ; must evaluate to true. Any core implementation runs this same file.
]

"arithmetic"
[1 + 2 * 3 = 9]
[7 / 2 = 3.5]
[6 / 3 == 2]
[-7 // 2 = -1]
[$0.10 + $0.20 == $0.30]
[error? try [9223372036854775807 + 1]]
[1:00 + 0:30 = 1:30]
[3x4 + 1 = 4x5]
[7 = max 3 7]
["a" = min "b" "a"]
[5 = abs -5]

"round"
[13.0 == round 12.5]
[-13.0 == round -12.5]
[7 == round 7]
[3.14 == round/to 3.14159 0.01]
[2.68 == round/to 2.675 0.01]
[12 == round/to 12.345 1]
[15 == round/to 17 5]
[2.0 == round/even 2.5]
[4.0 == round/even 3.5]
[12.0 == round/down 12.9]
[-2.0 == round/floor -1.5]
[2.0 == round/ceiling 1.1]
[2.0 == round/half-down 2.5]
[-2.0 == round/half-ceiling -2.5]
[$15.13 == round/to $15.125 $0.01]
[$2.63 == round/to $2.625 0.01]
[$15.00 == round $15.125]
[13% == round 12.5%]
[1:30:46 == round 1:30:45.6]
[1:30 == round/to 1:37 0:15]
[error? try [round/to 1 0]]

"date parts"
[d: 14-Nov-2026/10:30 6 = d/weekday]
[d: 14-Nov-2026/10:30 318 = d/yearday]
[d: 14-Nov-2026/10:30 14-Nov-2026 == d/date]
[d: 14-Nov-2026/10:30 all [10 = d/hour 30 = d/minute 0 = d/second]]
[d: 14-Nov-2026 none? d/hour]
[d: 9-Nov-2026 1 = d/weekday]
[d: 15-Nov-2026 7 = d/weekday]

"reflection"
[f: func ["Doc." a [integer!] /r b] [a] ["Doc." a [integer!] /r b] = spec-of :f]
[f: func [a] [a + 1] [a + 1] = body-of :f]
[f: func [a /r b /local c] [a] [a /r b] = words-of :f]
[none? body-of :append]
[block? spec-of :append]
[(spec-of :+) = spec-of :add]
[[a b] = words-of make object! [a: 1 b: 2]]
[[1 2] = values-of make object! [a: 1 b: 2]]
[[a b] = words-of #(a: 1 b: 2)]
[[1 2] = values-of #(a: 1 b: 2)]
[f: func [a] [a] s: spec-of :f append s 'x [a] = spec-of :f]
["func [a] [a + 1]" = mold func [a] [a + 1]]
["#[function!]" = mold/all func [a] [a]]
["func [a /local b] [b: a]" = mold function [a] [b: a]]
["func [a] [a + 1]" = mold function [a] [a + 1]]
[o: make object! [w: 'red p: 'a/b n: none b: [x y]]  (mold o) = "make object! [^/    w: 'red^/    p: 'a/b^/    n: none^/    b: [x y]^/]"]
[o: make object! [w: 'red p: 'a/b]  o2: do mold o  all [o2/w = 'red  o2/p = 'a/b]]

"comparison"
[1 = 1.0]
[not 1 == 1.0]
["Hello" = "hello"]
[#"a" = #"A"]
['abc = first [abc:]]
[[1 2] = [1 2]]
[1-Jan-2026 < 2-Jan-2026]
[2 >= 2]
[1 <> 2]

"logic"
[true and true]
[not (true and false)]
[false or true]
[6 and 3 = 2]
[none? all [1 none 3]]
[7 = any [none false 7]]

"words and paths"
[x: 10 x = 10]
[b: [a 1 b 2] b/b = 2]
[b: [10 20 30] n: 2 b/:n = 20]
[o: make object! [p: make object! [q: 5]] o/p/q = 5]
[o: make object! [v: 1] o/v: 2 o/v = 2]
[m: make map! [k 1] m/k: 2 m/k = 2]
[m: make map! [] none? m/missing]
[d: 30-Oct-2026 d/month = 10]

"functions"
[f: func [a b] [a + b] (f 1 2) = 3]
[f: func [n] [either n < 2 [n] [(f n - 1) + f n - 2]] (f 15) = 610]
[f: func [/opt v] [either opt [v] [0]] all [(f) = 0 (f/opt 5) = 5]]
[mk: func [n] [does [n]] a: mk 1 b: mk 2 all [(a) = 1 (b) = 2]]
[f: func [x [integer!]] [x] error? try [f "no"]]
[f: does [return 1 2] (f) = 1]

"objects"
[o: context [a: 1 get-a: does [a]] (o/get-a) = 1]
[p: context [n: 1 f: does [n]] q: make p [n: 2] all [(p/f) = 1 (q/f) = 2]]
[o: context [a: 1] (length? o) = 1]
[p: context [b: [] s: ""] q: make p [] append q/b 1 append q/s "x" all [empty? p/b empty? p/s]]

"loops"
[n: 0 loop 4 [n: n + 1] n = 4]
[s: 0 repeat i 10 [s: s + i] s = 55]
[out: copy "" foreach c "abc" [append out c] out = "abc"]
[n: 0 while [n < 100] [n: n + 1 if n = 7 [break]] n = 7]
[(loop 3 [break/return 9]) = 9]
[s: 0 repeat i 4 [if i = 2 [continue] s: s + i] s = 8]

"errors"
[e: try [1 / 0] e/type = 'math]
[e: try [undefined-thing] e/id = 'no-value]
[e: try [do make error! "custom"] e/message = "custom"]
[none? attempt [1 / 0]]
[(catch [throw 3]) = 3]
[(catch/name [throw/name 4 'k] 'k) = 4]

"evaluation"
[(do [1 + 1]) = 2]
[(do "2 * 3") = 6]
[(reduce [1 + 1 2 * 2]) = [2 4]]
[(quote (1 + 2)) = quote (1 + 2)]
[c: 0 case/all [true [c: c + 1] true [c: c + 1]] c = 2]
[(switch 'b [a [1] b [2]]) = 2]

"same?"
[a: [1 2]  same? a a]
[not same? [1 2] [1 2]]
[a: [1 2]  not same? a next a]
[o: make object! [x: 1]  same? o o]
[not same? make object! [x: 1] make object! [x: 1]]
[same? 1 1]
[not same? 1 2]
