; A part of the UI dialect: see ui.trb, whose words it shares.

; --- laying out -----------------------------------------------------------------

; Labels (`search: field`, `table clients`) are local to the layout, as R3
; planned for its VID: each layout gets an object holding them, and the
; layout's blocks (its handlers too) are bound to it. `global search: field`
; sets a global word instead.

layout: function [
    "Turns a block of the UI dialect into a view face; /only gives the block of faces."
    spec [block!]
    /only "Return the faces, not a view holding them"
    /local def
] [
    ; a copy, so laying out the same block twice never shares bindings
    spec: copy/deep spec
    labels: copy []
    either only [
        out: ui-build spec labels
    ] [
        ; what comes before the first face belongs to the view itself, read as any face's
        out: make select styles 'view []
        def: select ui-style-defs 'view
        out/pane: ui-build/in spec labels out def
        ui-take-done out def spec
    ]
    bind-labels spec labels copy []
    morphs either only [out] [reduce [out]]
    out
]

; What a block of faces says of the face that holds it, before its first face: its words,
; events and values, read by what def takes, as those after a face. Where the faces start.
ui-head: function [f def spec [block!] labels [block!] /local p q ev b w] [
    parse spec [any [
        p: set ev word! if (event-word? ev) set b block! (ui-take-event f def p ev b)
        | p: if (all [not ui-style first p  q: ui-take f def p labels]) :q
        ; a word of the face's own given the wrong value: width fil
        | p: set w word! if (all [not ui-style w  ui-keyword def w]) (ui-problem p ui-stray def w)
            opt [if (ui-stray-takes? def p) q: if (not any [ui-style first q  set-word? first q]) skip]
    ] body:]
    body
]

; Binds a laid-out block to an object of its labels and the given [word: value ...].
bind-labels: function [spec [block!] labels [block!] words [block!] /local w f] [
    foreach [w f] labels [append words reduce [to set-word! w f]]
    unless empty? words [bind spec make object! words]
]

; Works out the morph names given as blocks once the layout's words are bound: in
; [client id] the first word is the name as written, and what follows is evaluated.
morphs: function [faces [block!]] [
    if ui-checking [exit]
    foreach f faces [foreach g all-faces f [
        if all [block? m: g/morph  not empty? m  word? first m] [g/morph: append reduce [first m] reduce next m]
    ]]
]

; Keeps a label for a face: in the layout's labels, or as a global word.
label-face: function [label labels [block!] global? [logic!] f] [
    either global? [set label f] [
        w: to word! label
        either p: find/skip labels w 2 [p/2: f] [append labels reduce [w f]]
    ]
]

; A text of the interface: a string, a text per language (a map), or a word of
; the dictionary written as a lit-word ('save). Faces keep it as given and the
; host shows it in the active language, so set-language translates them.
text-rule: [string! | map! | lit-word!]
text-of: func [t] [either lit-word? :t [to word! t] [t]]

; The faces of a block of the dialect; labels collects [word face ...]. What follows each
; style is read by what the style takes (takes.trb); texts, events, reactions and blocks are
; read the same for every style.
build-faces: function [
    spec [block!] labels [block!]
    /local label global? style-word f def used s b w v ev p q pos later began ended
] [
    out: copy []
    ; what starts the next face
    face-start: [set-word! | 'global | set w word! if (ui-style w)]
    modifier: [
        ; ui-check reads view compose [...] with its parens in it: menu (looks)
        if (ui-checking) opt [set w word! if (any [ui-keyword def w  select ui-takes w])] some paren!
        | p: if (q: ui-take f def p labels) :q
        | set s [string! | map!] (either f/text [f/hint: s] [f/text: s])
        ; a word of the dictionary: button 'save
        | set v lit-word! (v: to word! v  either f/text [f/hint: v] [f/text: v])
        | p: set ev word! if (event-word? ev) set b block! (ui-take-event f def p ev b)
        | 'calc set b block! (add-reaction f 'calc b false  f/readonly: true)
        | 'is set b block! (add-reaction f 'is b false)
        | 'react (later: false) opt ['later (later: true)] set b block! (add-reaction f 'react b later)
        | pos: set b block! (ui-take-block f def b used pos labels)
    ]
    parse spec [any [
        (label: none  global?: false)
        began:
        opt ['global (global?: true)]
        opt [set label set-word!]
        [
            ; a face that compose puts in: check takes what follows as words of a face it cannot know,
            ; up to the next style; a bare block is its action or pane, which check cannot read either
            if (ui-checking) paren! (def: ui-any  f: make def/proto []  used: copy []) any [
                not face-start [block! | modifier]
            ]
        |   pos: set style-word word! if (ui-style style-word) (
                def: select ui-style-defs style-word
                f: make select styles style-word []
                used: copy []
                f/place: loaded-at pos
                append out f
                if label [label-face label labels global? f]
            )
            p: (q: ui-take-leads f def p labels global?) :q
            any [
                modifier
                ; a mistyped style starts a face of its own: what follows it is that face's
                | pos: not face-start skip (ui-problem pos ui-stray def first pos) opt [
                    if (ui-meant-style def first pos) any [not face-start skip]
                    ; a word that takes a value (here or in another style, or mistyped): its value goes with it
                    | if (ui-stray-takes? def pos) not face-start skip
                ]
            ]
            ended: (f/written: reduce [loaded-at began  loaded-at back ended])
            (ui-take-done f def began)
            ; not a style: a problem, then on to the next face
        |   pos: skip (
                w: first pos
                ui-problem pos case [
                    not word? :w [rejoin ["a face starts with a style, not " ui-shown :w]]
                    find ui-dialect-words w [rejoin [w " is not a style; it goes after one"]]
                    true [rejoin [w " is not a style" ui-suggest w words-of styles]]
                ]
            ) any [not face-start skip]
        ]
    ]]
    out
]

; A slider goes from 0 to 100 unless told, one at a time, and starts at its least.
slider-fill: function [f place [block!]] [
    unless rule-of f 'min [add-rule f copy [min 0]]
    unless rule-of f 'max [add-rule f copy [max 100]]
    low: rule-of f 'min  high: rule-of f 'max
    unless all [number? low  number? high  low < high] [
        ui-problem place "a slider takes its least and its most as two numbers, the least first: 0 100"
        exit
    ]
    if all [f/step  any [f/step <= 0  f/step > (high - low)]] [
        ui-problem place "a slider's step is a number above 0 and no more than its most less its least"
    ]
    if none? f/value [f/value: low]
]

; Where a slider stands for a number given to it: within its least and most.
slider-at: function [f v] [
    unless number? :v [return f/value]
    max rule-of f 'min min rule-of f 'max v
]

spacing: func [n [integer!] place [block!]] [
    if all [n >= 0  n <= 7] [return n]
    ui-problem place rejoin [first place " takes a step from 0 to 7"]
    0
]

; [name "Name" email] -> [name "Name" email "email"]
; A column of images keeps what it is with its label: [photo "" image round] -> [photo ["" image round]]
columns-of: function [spec [block!] /local w label kind p] [
    out: copy []
    parse spec [any [
        set w word! (label: form w  kind: none) opt [set label text-rule]
        opt ['image (kind: copy [image]) opt ['round (append kind 'round)]]
        (
            label: text-of label
            append out w
            append/only out either kind [head insert/only kind label] [label]
        )
        | p: skip (ui-problem p "table columns are words, each with an optional label, then image or image round") to end
    ]]
    out
]

; [name desc] -> [name desc], checked
sort-order: function [b [block!]] [
    unless parse b [word! ['asc | 'desc]] [ui-problem b "sorted takes a column and asc or desc"]
    copy b
]

; ["General" [...] "Advanced" [...]] -> a tab face per pair
tabs-of: function [spec [block!] labels [block!] /local p q bp] [
    out: copy []
    parse spec [any [
        q: set label text-rule bp: set b block! (
            label: text-of label
            t: make select styles 'tab [text: label pane: build-faces b labels]
            ; where it was written: its label and its block
            t/written: reduce [loaded-at q  loaded-at bp]
            append out t
        )
        | p: skip (ui-problem p "tabs take a label and a block per tab") to end
    ]]
    out
]
