; A part of the UI dialect: see ui.trb, whose words it shares.

; --- a number that stands for something (after composites.trb and styles-more.trb) ----------
;
; stat "Takings" $1240.00 "12 repairs today" trend [980 1100 1240] success count
;
; Its text is what the number is, its value the number, a second text the line under it,
; trend the numbers it had, oldest first, drawn as a small line, and its role the colour of
; the number and the line. With count a new number runs from the old one.
;
; It is made of other styles, as any app may make its own: a card whose faces follow it.

stylize [
    stat: panel [
        pad: 5  gap: 1
        takes: [
            value: [number! money!] "the number it shows"
            count: 'count "a number that changes runs from the old one to the new"
            trend: 'trend [block!] "the numbers it had, oldest first, drawn as a small line: trend [3 5 4 8]"
            done: :stat-check
        ]
        layout: [
            text muted small bold is [it/text]
            title shrink is [it/value] react [face/count: it/count]
            text muted small is [it/hint] react [face/hidden: none? it/hint]
            canvas 100x40 stretch react [face/draw: stat-trend it/trend it/role  face/hidden: none? face/draw]
        ]
    ]
]

; trend [3 5 4 8]: numbers or amounts only, two at least
stat-check: func [f place [block!]] [
    all [
        f/trend
        not parse f/trend [2 [number! | money!] any [number! | money!]]
        ui-problem place "a trend takes two numbers or more: trend [3 5 4 8]"
    ]
]

; The drawing of a trend in a canvas of 100x40, spread to its width: an area under a line
; through the numbers, lowest at the foot, highest at the top, ending on a dot. A flat trend
; runs across the middle. In the colour of role, primary when none; none if fewer than two.
stat-trend: function [trend role] [
    ns: copy []
    foreach v any [trend []] [if any [number? :v  money? :v] [append ns to decimal! v]]
    if 2 > length? ns [return none]
    lo: hi: first ns
    foreach n ns [lo: min lo n  hi: max hi n]
    c: case [none? role ['primary]  role = 'muted ['border-strong]  true [role]]
    step: 100 / ((length? ns) - 1)
    points: copy []
    repeat i length? ns [
        y: either hi = lo [24] [11 + (26 * (1 - ((pick ns i) - lo / (hi - lo))))]
        append points as-pair i - 1 * step y
    ]
    compose [
        pen off  fill-pen (c) 14%  polygon (points) 100x40 0x40
        pen (c) line-width 2 line-join round line-cap round fill-pen off  line (points)
        pen raised fill-pen (c)  circle (last points) 4.5
    ]
]
