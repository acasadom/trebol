Trebol [
    title: "UI dialect: faces, styles, layout and validation"
    exports: [
        face styles stylize layout view theme open close toast
        validate-face form-values set-values ui-pane ui-input ui-files ui-remove-file ui-blur ui-click ui-select ui-close ui-event ui-menu ui-drop ui-reorder ui-crumb ui-expand
        go ui-route set-language
    ]
]

; --- faces ---------------------------------------------------------------------
;
; A face is an object. The host keeps one DOM node per face and copies these
; fields to it after every scheduler slice, so code changes a face by
; setting a field: `total/text: "42"`.

face: make object! [
    style: 'face        ; what the host renders
    name: none          ; field name: the key in `values`, and a word in handlers
    text: none          ; label, caption or content
    value: none         ; a field's value; also a progress (0-1 or percent) or an image (file or url)
    hint: none          ; placeholder
    role: none          ; primary accent danger success warning muted
    size: none          ; small medium large
    align: none         ; left center right spread
    cols: none          ; columns of a grid
    icon: none
    fill: false
    pad: none           ; inner and between-children spacing, a step of the spacing scale (0-7)
    gap: none
    narrow-only: false  ; shown only on narrow screens
    wide-only: false    ; hidden on narrow screens
    hidden: false
    disabled: false
    drag: false         ; can be dragged: carries its value, or the row in a table, list or tree
    drop: false         ; accepts drops (on-drop)
    reorder: false      ; its children or rows can be moved around (on-reorder)
    rules: none         ; validation: a block of [rule args...] blocks
    error: none         ; current message, shown once the face is touched
    touched: false
    pending: false      ; an asynchronous check is running
    async-error: none   ; result of the last asynchronous check
    action: none        ; the block after the face: click, change
    events: none        ; [on-change [...] on-select [...]]
    shortcut: none      ; a key that activates a button or link: "Ctrl+S"
    menu: none          ; context menu (or the menu a button opens): a block of menu items; on-menu runs
    options: none       ; choices of a choice or radio
    currency: none      ; a money field's currency code: EUR
    typed: none         ; what the user typed in a number, money or date field when it is not one;
                        ; in an upload, the names of the files it refused
    multiple: false     ; an upload takes more than one file
    accept: none        ; the files an upload takes: ["pdf" "image/*"]
    pane: none
    columns: none       ; table, list and tree: [field "Label" ...]
    data: none          ; table, list and tree: a block of map! or object! rows (a tree's
                        ; have their own in `children`); breadcrumb: its items
    key: 'id            ; the row field that identifies a row
    selected: none      ; the row last chosen
    form: none          ; the enclosing form, if any
    root: none          ; the view this face belongs to
    submit: false
]

; style name -> prototype face
styles: make map! []

container-styles: [view column row form panel grid dialog scroll split toolbar]
input-styles: [field password number money date area check toggle choice radio upload]
data-styles: [table list tree]

foreach [name base] [
    view column  column column  row row  form form  panel panel  grid grid  scroll scroll
    title title  heading heading  text text  divider divider
    field field  password password  number number  money money  date date  area area  check check  choice choice
    toggle toggle  radio radio  upload upload  progress progress  image image  icon icon
    button button  link link  table table  list list  tabs tabs  tab tab
    toolbar toolbar  breadcrumb breadcrumb  tree tree  screens screens  screen screen
] [
    poke styles name make face [style: base]
]
poke styles 'view make face [style: 'view]
poke styles 'submit make face [style: 'button role: 'primary submit: true]
poke styles 'dialog make face [style: 'dialog hidden: true]
poke styles 'tabs make face [style: 'tabs value: 1]
poke styles 'split make face [style: 'split value: 1]   ; value: the pane shown on narrow screens

stylize: function [
    "Defines styles from existing ones: name: base [field: value ...]"
    spec [block!]
] [
    parse spec [some [
        set name set-word! set base word! set defaults block! (
            proto: select styles base
            unless proto [do make error! rejoin ["stylize: unknown style " base]]
            poke styles to word! name make proto defaults
        )
    ]]
]

; --- layout --------------------------------------------------------------------

roles: [primary accent danger success warning muted]
sizes: [small medium large]
aligns: [left center right spread]
flags: [fill hidden disabled narrow-only wide-only drag drop reorder multiple]
simple-rules: [required email url integer]
letter: charset [#"a" - #"z" #"A" - #"Z"]
rule-words: [min max length pattern match check check-async width pad gap menu accept]

; Words that never name a field. email, url and integer are rules too,
; but also common field names, so the first word after an input style names it.
field-name?: func [w [word!]] [
    not any [
        find roles w  find sizes w  find aligns w  find flags w
        find rule-words w  w = 'required  event-word? w
    ]
]

add-rule: func [f rule [block!]] [
    unless f/rules [f/rules: copy []]
    append/only f/rules rule
]

event-word?: func [w [word!]] [
    to logic! find/match form w "on-"
]

; Labels (`search: field`, `table clients`) are local to the layout, as R3
; planned for its VID: each layout gets an object holding them, and the
; layout's blocks (its handlers too) are bound to it. `global search: field`
; sets a global word instead.

layout: function [
    "Turns a block of the UI dialect into a view face; /only gives the block of faces."
    spec [block!]
    /only "Return the faces, not a view holding them"
    /local ev b
] [
    ; a copy, so laying out the same block twice never shares bindings
    spec: copy/deep spec
    labels: copy []
    either only [
        out: build-faces spec labels
    ] [
        ; on-xxx handlers before the first face belong to the view itself
        events: copy []
        parse spec [any [set ev word! if (event-word? ev) set b block! (append events reduce [ev b])] body:]
        out: make select styles 'view [pane: build-faces body labels]
        unless empty? events [out/events: events]
    ]
    bind-labels spec labels copy []
    out
]

; Binds a laid-out block to an object of its labels and the given [word: value ...].
bind-labels: function [spec [block!] labels [block!] words [block!] /local w f] [
    foreach [w f] labels [append words reduce [to set-word! w f]]
    unless empty? words [bind spec make object! words]
]

; Keeps a label for a face: in the layout's labels, or as a global word.
label-face: function [label labels [block!] global? [logic!] f] [
    either global? [set label f] [
        w: to word! label
        either p: find/skip labels w 2 [p/2: f] [append labels reduce [w f]]
    ]
]

; The faces of a block of the dialect; labels collects [word face ...].
build-faces: function [
    spec [block!] labels [block!]
    /local label global? style-word f proto n s b w a i v ev
] [
    out: copy []
    modifier: [
        set s string! (either f/text [f/hint: s] [f/text: s])
        | set ev word! if (event-word? ev) set b block! (
            unless f/events [f/events: copy []]
            append f/events reduce [ev b]
        )
        | set b block! (
            case [
                find container-styles f/style [
                    ; --- in a toolbar is a separator
                    f/pane: build-faces either f/style = 'toolbar [replace/all copy b '--- 'divider] [b] labels
                    if all [f/style = 'split  2 <> length? f/pane] [
                        do make error! "layout: split takes two faces, one per pane"
                    ]
                ]
                find data-styles f/style [f/columns: columns-of b]
                ; the first block holds the items, the second is the action
                all [f/style = 'breadcrumb  none? f/data] [f/data: crumbs-of b]
                f/style = 'tabs [f/pane: tabs-of b labels]
                f/style = 'screens [f/data: screens-of b]
                find [choice radio] f/style [f/options: reduce b]
                true [f/action: b]
            ]
        )
        | set i issue! (f/icon: i)
        | set v [file! | url! | percent!] (f/value: v)
        ; a link to a screen: link "Clients" 'clients, link "Ada" 'client/42
        | set v lit-word! (f/value: to word! v)
        | set v lit-path! (f/value: to path! v)
        | set n integer! (f/cols: n)
        | 'min set n [number! | money! | date!] (add-rule f reduce ['min n])
        | 'max set n [number! | money! | date!] (add-rule f reduce ['max n])
        | 'length set a integer! set n integer! (add-rule f reduce ['length a n])
        | 'pattern set b block! (add-rule f reduce ['pattern b])
        | 'accept set b block! (f/accept: b)
        | 'match set w word! (add-rule f reduce ['match w])
        | 'check set b block! (add-rule f reduce ['check b])
        | 'check-async set b block! (add-rule f reduce ['check-async b])
        | 'width set w word! (f/size: w)
        | set w ['pad | 'gap] [set n integer! | 'none (n: 0) | 'wide (n: 6)] (poke f w spacing n)
        | 'menu set b block! (f/menu: menu-of b)
        | 'key set s string! (f/shortcut: s)
        | 'key set w word! (f/key: w)
        | set w word! if (find roles w) (f/role: w)
        | set w word! if (find sizes w) (f/size: w)
        | set w word! if (find aligns w) (f/align: w)
        | set w word! if (find flags w) (poke f w true)
        | set w word! if (find simple-rules w) (add-rule f reduce [w])
        ; money price "Price" EUR
        | set w word! if (all [f/style = 'money  parse form w [3 letter]]) (f/currency: to word! uppercase form w)
    ]
    unless parse spec [
        any [
            (label: none  global?: false)
            opt ['global (global?: true)]
            opt [set label set-word!]
            set style-word word! (
                proto: select styles style-word
                unless proto [do make error! rejoin ["layout: unknown style " style-word]]
                f: make proto []
                append out f
                if label [label-face label labels global? f]
            )
            opt [if (find input-styles f/style) set n word! if (field-name? n) (f/name: n)]
            ; table clients [...] is the same as clients: table [...]
            opt [if (find data-styles f/style) set n word! if (all [field-name? n  n <> 'key]) (label-face n labels global? f)]
            any modifier
        ]
    ] [
        do make error! "layout: cannot read the layout"
    ]
    out
]

spacing: func [n [integer!]] [
    unless all [n >= 0  n <= 7] [do make error! "layout: pad and gap take a step from 0 to 7"]
    n
]

; [name "Name" email] -> [name "Name" email "email"]
columns-of: function [spec [block!]] [
    out: copy []
    unless parse spec [any [set w word! (label: form w) opt [set label string!] (append out reduce [w label])]] [
        do make error! "layout: table columns are words, each with an optional label"
    ]
    out
]

; ["General" [...] "Advanced" [...]] -> a tab face per pair
tabs-of: function [spec [block!] labels [block!]] [
    out: copy []
    unless parse spec [any [set label string! set b block! (
        append out make select styles 'tab [text: label pane: build-faces b labels]
    )]] [
        do make error! "layout: tabs take a label and a block per tab"
    ]
    out
]

; [home "Home" [...] client "Client" [id] [...]] -> [name title args body ...]
screens-of: function [spec [block!] /local n t a b] [
    out: copy []
    unless parse spec [some [
        set n word! set t string! (a: copy []) opt [ahead [block! block!] set a block!] set b block! (
            foreach w a [unless word? w [do make error! "layout: the arguments of a screen are words"]]
            append out reduce [n t a b]
        )
    ]] [
        do make error! "layout: screens take a name, a title, an optional block of arguments and a block per screen"
    ]
    out
]

menu-item: make object! [
    text: none
    icon: none
    id: none            ; the word on-menu gets in event/picked
    items: none         ; a submenu
    divider: false
]

; As in Red: ["Edit" edit #trash "Delete" delete --- "Move to" ["Top" top]] -> menu items
menu-of: function [spec [block!] /local i label w b] [
    out: copy []
    unless parse spec [any [
        '--- (append out make menu-item [divider: true])
        | (i: none) opt [set i issue!] set label string! [
            set b block! (append out make menu-item [text: label icon: i items: menu-of b])
            | set w word! (append out make menu-item [text: label icon: i id: w])
        ]
    ]] [
        do make error! "layout: a menu takes a label and a word per item, a block for a submenu, or ---"
    ]
    out
]

; ["Home" home "Clients" clients "Ada"]: a label and a word per item; the last one may have no word
crumbs-of: function [spec [block!] /local label w] [
    unless parse spec [any [set label string! set w word!] opt string!] [
        do make error! "layout: a breadcrumb takes a label and a word per item; only the last may have no word"
    ]
    copy spec
]

; Links each face to its view and form, so handlers can find `values`.
attach: function [f root form] [
    f/root: root
    f/form: form
    if f/pane [
        inner: either f/style = 'form [f] [form]
        foreach c f/pane [attach c root inner]
    ]
]

view: function [
    "Shows a layout (a block of the dialect, or a face from layout) as the page."
    spec [block! object!]
] [
    root: either block? spec [layout spec] [spec]
    attach root root none
    entered: copy []
    foreach f all-faces root [
        if f/style = 'screens [
            set 'router f
            append entered follow-link f route
        ]
    ]
    foreach f all-faces root [refresh-form f]
    show root
    foreach s entered [run-enter s]
    root
]

; --- screens -------------------------------------------------------------------
;
; A screens face shows one screen at a time and keeps the page's link in step:
; the screen `client [id]` showing id "42" is #/client/42. A route is a block
; of the screen name and its arguments as strings, as they come in the link.

router: none        ; the screens face of the page

; The [name title args body] of the screen a route names, or none.
find-screen: function [f route [block!] /local n t a b] [
    if any [empty? route  not word? first route] [return none]
    foreach [n t a b] f/data [
        if all [n = first route  (length? a) = ((length? route) - 1)] [return reduce [n t a b]]
    ]
    none
]

; Builds the screen a route names as the only child of f; returns the screen face.
enter-screen: function [f route [block!] /local ev b] [
    def: find-screen f route
    ; a screen's arguments and labels are local to it
    spec: copy/deep def/4
    labels: copy []
    ; on-xxx handlers before the first face belong to the screen
    events: copy []
    parse spec [any [set ev word! if (event-word? ev) set b block! (append events reduce [ev b])] body:]
    s: make select styles 'screen [text: def/2  pane: build-faces body labels]
    unless empty? events [s/events: events]
    words: copy []
    repeat i length? def/3 [append words reduce [to set-word! pick def/3 i  pick route i + 1]]
    bind-labels spec labels words
    f/value: copy route
    f/pane: reduce [s]
    ui-pane f
    s
]

run-enter: function [s] [
    if h: handler-for s 'on-enter [run-handler s h]
]

; Shows the screen of a link given as a block of strings; a link that names no
; screen shows the first one and is replaced by its link.
follow-link: function [f parts [block!]] [
    route: copy parts
    unless empty? route [route/1: attempt [to word! route/1]]
    unless find-screen f route [
        route: reduce [first f/data]
        set-route route true
    ]
    enter-screen f route
]

go: function [
    "Shows a screen and gives the page its link: go 'clients, go [client row/id] (the name is not evaluated, the arguments are)."
    target [word! block!]
] [
    unless router [do make error! "go: the view has no screens"]
    route: reduce [either word? target [target] [first target]]
    if block? target [foreach a reduce next target [append route form a]]
    unless find-screen router route [do make error! rejoin ["go: no screen for " mold route]]
    set-route route false
    run-enter enter-screen router route
]

ui-route: function [
    "Called by the host when the page's link changes: back, forward or a link."
    f parts [block!]
] [
    route: copy parts
    unless empty? route [route/1: attempt [to word! route/1]]
    if route = f/value [exit]
    run-enter follow-link f parts
]

ui-pane: function [
    "Called by the host when code gave a face a new pane: links the new faces to their view and form."
    f
] [
    inner: either f/style = 'form [f] [f/form]
    foreach c any [f/pane []] [attach c f/root inner]
    if f/root [refresh-form any [inner f/root]]
]

open: func [
    "Shows a dialog."
    dialog [object!]
] [
    dialog/hidden: false
]

close: func [
    "Hides a dialog; closes a stream."
    target [object! handle!]
] [
    either object? target [target/hidden: true] [close-stream target]
]

toast: func [
    "Shows a short notice that goes away by itself."
    message [string!]
    /role "primary, success, warning or danger"
        kind [word!]
] [
    show-toast message either role [kind] [none]
]

set-language: func [
    "Changes the active language and shows every face again in it."
    language [word! string!]
] [
    i18n/language: either string? language [to word! language] [language]
    repaint
]

theme: func [
    "Sets the theme from a few parameters."
    spec [block!]
] [
    apply-theme construct spec
]

; --- walking faces -------------------------------------------------------------

all-faces: function [f] [
    out: copy []
    collect-faces f out
    out
]

collect-faces: function [f out] [
    append out f
    if f/pane [foreach c f/pane [collect-faces c out]]
]

; Faces that belong to a scope: nested forms keep their own fields and submits.
own-faces: function [scope] [
    out: reduce [scope]
    if scope/pane [foreach c scope/pane [collect-own c out]]
    out
]

collect-own: function [f out] [
    append out f
    if all [f/pane  f/style <> 'form] [foreach c f/pane [collect-own c out]]
]

named-faces: function [scope] [
    out: copy []
    foreach f all-faces scope [if f/name [append out f]]
    out
]

form-values: function [
    "The values of the named fields of a form (or view), as a map."
    scope
] [
    m: make map! []
    foreach f named-faces scope [poke m f/name f/value]
    m
]

set-values: function [
    "Fills the named fields of a form (or view) from a map or object; none clears them."
    scope data [map! object! none!]
] [
    foreach f named-faces scope [
        v: either data [select data f/name] [none]
        f/value: either logic-face? f [true = v] [v]
        f/touched: false
        f/typed: none
        f/async-error: none
    ]
    refresh-form scope
]

; --- validation ------------------------------------------------------------------

messages: make map! [
    required "This field is required"
    email "Enter a valid email address"
    url "Enter a valid web address"
    integer "Enter a whole number"
    number "Enter a number"
    amount "Enter an amount"
    date "Enter a valid date"
    accept "Only #1 files"
    min "Must be at least #1"
    max "Must be at most #1"
    length "Must be between #1 and #2 characters"
    length-exact "Must be exactly #1 characters"
    pattern "This value is not valid"
    match "Must match #1"
    check "This value is not valid"
]

message: function [key args [block!]] [
    out: copy select messages key
    repeat i length? args [replace out rejoin ["#" i] localize pick args i]
    out
]

digit: charset "0123456789"
word-char: charset [#"a" - #"z" #"A" - #"Z" #"0" - #"9" "._%+-"]
host-char: charset [#"a" - #"z" #"A" - #"Z" #"0" - #"9" "-"]
email-rule: [some word-char "@" some host-char some ["." some host-char] end]
url-rule: [["http://" | "https://"] some host-char any ["." some host-char] opt [":" some digit] opt ["/" to end] end]

; check and toggle hold true or false
logic-face?: func [f] [to logic! find [check toggle] f/style]

blank?: func [v] [
    any [none? :v  all [string? :v  empty? trim copy v]]
]

label-of: func [f] [any [f/text  form f/name]]

list-of: function [items [block!]] [
    out: copy ""
    foreach x items [unless empty? out [append out ", "] append out form x]
    out
]

; The message for the first rule a face breaks, or none. Asynchronous checks
; are skipped here: their last result is kept in async-error.
validate-face: function [
    "Checks a face's rules; returns a message or none."
    f
] [
    v: f/value
    rules: any [f/rules []]
    if f/typed [
        if f/style = 'upload [return message 'accept reduce [list-of f/accept]]
        return message select [number number money amount date date] f/style []
    ]
    if blank? :v [
        return either find/only rules [required] [message 'required []] [none]
    ]
    if all [logic-face? f  find/only rules [required]  not v] [return message 'required []]
    foreach r rules [
        problem: switch first r [
            email [unless parse v email-rule [message 'email []]]
            url [unless parse v url-rule [message 'url []]]
            integer [unless parse form v [opt "-" some digit] [message 'integer []]]
            min [if all [any [number? v  money? v  date? v]  v < r/2] [message 'min reduce [r/2]]]
            max [if all [any [number? v  money? v  date? v]  v > r/2] [message 'max reduce [r/2]]]
            length [
                n: length? form v
                if any [n < r/2  n > r/3] [
                    either r/2 = r/3 [message 'length-exact reduce [r/2]] [message 'length reduce [r/2 r/3]]
                ]
            ]
            pattern [unless parse form v r/2 [message 'pattern []]]
            match [
                other: find-named f r/2
                if all [other  v <> other/value] [message 'match reduce [label-of other]]
            ]
            check [check-result run-handler f r/2]
        ]
        if problem [return problem]
    ]
    f/async-error
]

check-result: func [result] [
    case [
        string? :result [result]
        any [none? :result  false = :result] [message 'check []]
        true [none]
    ]
]

find-named: function [f name] [
    scope: any [f/form f/root]
    foreach g named-faces scope [if g/name = name [return g]]
    none
]

; Runs asynchronous checks of a face (they may fetch).
check-async: function [f] [
    foreach r any [f/rules []] [
        if all [r/1 = 'check-async  not blank? f/value] [
            f/pending: true
            f/async-error: check-result run-handler f r/2
            f/pending: false
        ]
    ]
]

; Updates the errors of touched faces and enables submit buttons only when
; every field of the form is valid. A view checks only the faces outside its forms.
refresh-form: function [scope] [
    unless find [form view] scope/style [exit]
    ok: true
    faces: own-faces scope
    foreach f faces [
        if any [f/rules  f/typed  f/error] [
            problem: validate-face f
            f/error: either f/touched [problem] [none]
            if problem [ok: false]
        ]
    ]
    foreach f faces [if f/submit [f/disabled: not ok]]
]

; --- events --------------------------------------------------------------------
;
; The host calls these from DOM events, each in its own task.

; A handler block runs with face, value, values and, as in Red, event bound;
; event is an object (event/key, event/away? ...) or none. Named fields are
; not bound: their values are in values, their faces reached through labels.
run-handler: function [f body [block!] /with ev [object!] /on node "row is this node, not the selected one"] [
    scope: any [f/form f/root]
    words: compose [
        face: (f)
        value: (quoted f/value)
        values: (form-values any [scope f])
    ]
    if find data-styles f/style [append words compose [row: (either on [node] [f/selected])]]
    append words compose [event: (either with [ev] [none])]
    ctx: make object! words
    do bind copy/deep body ctx
]

; A value as it must appear in a block given to make object!
quoted: func [v] [either any [word? :v  path? :v] [to lit-word! :v] [:v]]

handler-for: function [f name] [
    all [f/events  select f/events name]
]

ui-input: function [
    "Called by the host when the user changes a field."
    f new
] [
    f/value: switch/default f/style [
        number [any [attempt [to decimal! new]  none]]
        ; the host gives the amount as 1234.5, whatever the language
        money [all [new  attempt [to money! rejoin [any [f/currency ""] "$" new]]]]
        ; and a date as 2026-11-03
        date [all [new  attempt [to date! new]]]
        check [to logic! new]
        toggle [to logic! new]
    ] [new]
    if f/style = 'number [
        if all [decimal? f/value  f/value = to integer! f/value] [f/value: to integer! f/value]
    ]
    ; text that is not a number, amount or date stays on screen, with its message
    f/typed: all [find [number money date] f/style  new  none? f/value  new]
    changed f
]

changed: function [f] [
    f/async-error: none
    refresh-form any [f/form f/root]
    if f/action [run-handler f f/action]
    if h: handler-for f 'on-change [run-handler f h]
]

; An upload's value is none or a block of objects [name size type file];
; file is a handle the host keeps, read with read-file or sent with multipart.
ui-files: function [
    "Called by the host when the user chooses or drops files: name size type file for each, and the names it refused."
    f files [block!] refused [block!]
] [
    chosen: collect [
        foreach [n s t h] files [keep make object! [name: n size: s type: t file: h]]
    ]
    unless empty? chosen [
        f/value: either f/multiple [append copy any [f/value []] chosen] [copy/part chosen 1]
    ]
    f/typed: either empty? refused [none] [refused]
    f/touched: true
    changed f
]

ui-remove-file: function [
    "Called by the host when the user removes the file at a position of an upload."
    f index [integer!]
] [
    files: remove at copy f/value index
    f/value: either empty? head files [none] [head files]
    f/typed: none
    changed f
]

ui-blur: function [
    "Called by the host when the user leaves a field."
    f
] [
    f/touched: true
    check-async f
    refresh-form any [f/form f/root]
]

ui-click: function [
    "Called by the host when the user activates a button."
    f
] [
    if f/submit [
        scope: any [f/form f/root]
        faces: own-faces scope
        foreach g faces [if g/rules [g/touched: true]]
        foreach g faces [check-async g]
        refresh-form scope
        if f/disabled [exit]
    ]
    if f/action [run-handler f f/action]
]

ui-select: function [
    "Called by the host when the user chooses a row of a table or list."
    f row
] [
    f/selected: row
    if h: handler-for f 'on-select [run-handler f h]
]

ui-close: function [
    "Called by the host when the user dismisses a dialog."
    f
] [
    f/hidden: true
    if h: handler-for f 'on-close [run-handler f h]
]

; Runs the on-xxx handler of an event with event bound to an object made of
; type (the event name without on-) and the given [word: value ...] fields.
fire-event: function [f name [word!] fields [block!]] [
    if h: handler-for f name [
        type: to word! skip form name 3
        run-handler/with f h make object! append reduce [quote type: to lit-word! type] fields
    ]
]

ui-event: function [
    "Called by the host for on-focus, on-unfocus, on-over, on-dbl-click and on-key."
    f name [word!] fields [block!]
] [
    fire-event f name fields
]

ui-crumb: function [
    "Called by the host when the user chooses an item of a breadcrumb."
    f item [word!]
] [
    f/value: item
    if f/action [run-handler f f/action]
]

ui-menu: function [
    "Called by the host when the user chooses a menu item; row is the row it was opened on."
    f item row
] [
    if row [f/selected: row]
    fire-event f 'on-menu reduce [quote picked: quoted item/id]
]

ui-drop: function [
    "Called by the host when something is dropped on a face; index is where it goes (1-based), parent the tree node."
    f dropped source index [integer!] parent
] [
    fields: reduce [quote dropped: quoted :dropped  quote source: source  quote index: index]
    if f/style = 'tree [append fields reduce [quote parent: parent]]
    fire-event f 'on-drop fields
]

ui-reorder: function [
    "Called by the host when the user moves a child or row of a face; in a tree, among the children of parent."
    f from [integer!] to [integer!] parent
] [
    fields: reduce [quote from: from  quote to: to]
    case [
        f/style = 'tree [
            either parent [parent/children: move-item parent/children from to] [f/data: move-item f/data from to]
            f/data: f/data      ; repaint the tree
            append fields reduce [quote parent: parent]
        ]
        find data-styles f/style [f/data: move-item f/data from to]
        true [f/pane: move-item f/pane from to]
    ]
    fire-event f 'on-reorder fields
]

ui-expand: function [
    "Called by the host when the user opens a node of a tree."
    f node
] [
    if h: handler-for f 'on-expand [
        run-handler/with/on f h make object! [type: 'expand] node
    ]
]

move-item: function [items [block!] from [integer!] to [integer!]] [
    items: copy items
    x: pick items from
    remove at items from
    insert/only at items to :x
    items
]
