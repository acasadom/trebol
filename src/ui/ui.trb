Trebol [
    title: "UI dialect: faces, styles, layout and validation"
    exports: [
        face styles stylize layout view theme open close toast
        validate-face form-values set-values set-content ui-input ui-blur ui-click ui-select ui-close
    ]
]

; --- faces ---------------------------------------------------------------------
;
; A face is an object. The host keeps one DOM node per face and copies these
; fields to it after every scheduler slice, so code changes a face by
; setting a field: `total/text: "42"`.

face: make object! [
    style: 'face        ; what the host renders
    name: none          ; field name: the key in `values`, and a word in handlers
    text: none          ; label, caption or content
    value: none         ; a field's value; also a progress (0-1 or percent) or an image (file or url)
    hint: none          ; placeholder
    role: none          ; primary accent danger success warning muted
    size: none          ; small medium large
    align: none         ; left center right spread
    cols: none          ; columns of a grid
    icon: none
    fill: false
    pad: none           ; inner and between-children spacing, a step of the spacing scale (0-7)
    gap: none
    narrow-only: false  ; shown only on narrow screens
    wide-only: false    ; hidden on narrow screens
    hidden: false
    disabled: false
    rules: none         ; validation: a block of [rule args...] blocks
    error: none         ; current message, shown once the face is touched
    touched: false
    pending: false      ; an asynchronous check is running
    async-error: none   ; result of the last asynchronous check
    action: none        ; the block after the face: click, change
    events: none        ; [on-change [...] on-select [...]]
    options: none       ; choices of a choice or radio
    children: none
    columns: none       ; table and list: [field "Label" ...]
    data: none          ; table and list: a block of map! or object! rows
    key: 'id            ; the row field that identifies a row
    selected: none      ; the row last chosen
    form: none          ; the enclosing form, if any
    root: none          ; the view this face belongs to
    submit: false
]

; style name -> prototype face
styles: make map! []

container-styles: [view column row form panel grid dialog scroll split]
input-styles: [field password number area check toggle choice radio]
data-styles: [table list]

foreach [name base] [
    view column  column column  row row  form form  panel panel  grid grid  scroll scroll
    title title  heading heading  text text  divider divider
    field field  password password  number number  area area  check check  choice choice
    toggle toggle  radio radio  progress progress  image image  icon icon
    button button  link link  table table  list list  tabs tabs  tab tab
] [
    poke styles name make face [style: base]
]
poke styles 'view make face [style: 'view]
poke styles 'submit make face [style: 'button role: 'primary submit: true]
poke styles 'dialog make face [style: 'dialog hidden: true]
poke styles 'tabs make face [style: 'tabs value: 1]
poke styles 'split make face [style: 'split value: 1]   ; value: the pane shown on narrow screens

stylize: function [
    "Defines styles from existing ones: name: base [field: value ...]"
    spec [block!]
] [
    parse spec [some [
        set name set-word! set base word! set defaults block! (
            proto: select styles base
            unless proto [do make error! rejoin ["stylize: unknown style " base]]
            poke styles to word! name make proto defaults
        )
    ]]
]

; --- layout --------------------------------------------------------------------

roles: [primary accent danger success warning muted]
sizes: [small medium large]
aligns: [left center right spread]
flags: [fill hidden disabled narrow-only wide-only]
simple-rules: [required email url integer date]
rule-words: [min max length pattern match check check-async width pad gap]

; Words that never name a field. email, url, integer and date are rules too,
; but also common field names, so the first word after an input style names it.
field-name?: func [w [word!]] [
    not any [
        find roles w  find sizes w  find aligns w  find flags w
        find rule-words w  w = 'required  event-word? w
    ]
]

add-rule: func [f rule [block!]] [
    unless f/rules [f/rules: copy []]
    append/only f/rules rule
]

event-word?: func [w [word!]] [
    to logic! find/match form w "on-"
]

layout: function [
    "Turns a block of the UI dialect into a block of faces."
    spec [block!]
    /local label style-word f proto n s b w a i v ev
] [
    out: copy []
    modifier: [
        set s string! (either f/text [f/hint: s] [f/text: s])
        | set ev word! if (event-word? ev) set b block! (
            unless f/events [f/events: copy []]
            append f/events reduce [ev b]
        )
        | set b block! (
            case [
                find container-styles f/style [
                    f/children: layout b
                    if all [f/style = 'split  2 <> length? f/children] [
                        do make error! "layout: split takes two faces, one per pane"
                    ]
                ]
                find data-styles f/style [f/columns: columns-of b]
                f/style = 'tabs [f/children: tabs-of b]
                find [choice radio] f/style [f/options: reduce b]
                true [f/action: b]
            ]
        )
        | set i issue! (f/icon: i)
        | set v [file! | url! | percent!] (f/value: v)
        | set n integer! (f/cols: n)
        | 'min set n number! (add-rule f reduce ['min n])
        | 'max set n number! (add-rule f reduce ['max n])
        | 'length set a integer! set n integer! (add-rule f reduce ['length a n])
        | 'pattern set b block! (add-rule f reduce ['pattern b])
        | 'match set w word! (add-rule f reduce ['match w])
        | 'check set b block! (add-rule f reduce ['check b])
        | 'check-async set b block! (add-rule f reduce ['check-async b])
        | 'width set w word! (f/size: w)
        | set w ['pad | 'gap] [set n integer! | 'none (n: 0) | 'wide (n: 6)] (poke f w spacing n)
        | 'key set w word! (f/key: w)
        | set w word! if (find roles w) (f/role: w)
        | set w word! if (find sizes w) (f/size: w)
        | set w word! if (find aligns w) (f/align: w)
        | set w word! if (find flags w) (poke f w true)
        | set w word! if (find simple-rules w) (add-rule f reduce [w])
    ]
    unless parse spec [
        any [
            (label: none)
            opt [set label set-word!]
            set style-word word! (
                proto: select styles style-word
                unless proto [do make error! rejoin ["layout: unknown style " style-word]]
                f: make proto []
                append out f
                if label [set label f]
            )
            opt [if (find input-styles f/style) set n word! if (field-name? n) (f/name: n)]
            ; table clients [...] is the same as clients: table [...]
            opt [if (find data-styles f/style) set n word! if (all [field-name? n  n <> 'key]) (set n f)]
            any modifier
        ]
    ] [
        do make error! "layout: cannot read the layout"
    ]
    out
]

spacing: func [n [integer!]] [
    unless all [n >= 0  n <= 7] [do make error! "layout: pad and gap take a step from 0 to 7"]
    n
]

; [name "Name" email] -> [name "Name" email "email"]
columns-of: function [spec [block!]] [
    out: copy []
    unless parse spec [any [set w word! (label: form w) opt [set label string!] (append out reduce [w label])]] [
        do make error! "layout: table columns are words, each with an optional label"
    ]
    out
]

; ["General" [...] "Advanced" [...]] -> a tab face per pair
tabs-of: function [spec [block!]] [
    out: copy []
    unless parse spec [any [set label string! set b block! (
        append out make select styles 'tab [text: label children: layout b]
    )]] [
        do make error! "layout: tabs take a label and a block per tab"
    ]
    out
]

; Links each face to its view and form, so handlers can find `values`.
attach: function [f root form] [
    f/root: root
    f/form: form
    if f/children [
        inner: either f/style = 'form [f] [form]
        foreach c f/children [attach c root inner]
    ]
]

view: function [
    "Shows a layout as the page."
    spec [block!]
] [
    root: make select styles 'view [children: layout spec]
    attach root root none
    foreach f all-faces root [refresh-form f]
    show root
]

set-content: function [
    "Replaces the faces inside a container with a new layout; the host rebuilds that part of the page."
    container [object!]
    spec [block!]
] [
    kids: layout spec
    inner: either container/style = 'form [container] [container/form]
    foreach c kids [attach c container/root inner]
    if all [container/style = 'split  2 <> length? kids] [
        do make error! "set-content: split takes two faces, one per pane"
    ]
    container/children: kids
    if container/root [refresh-form any [inner container/root]]
    container
]

open: func [
    "Shows a dialog."
    dialog [object!]
] [
    dialog/hidden: false
]

close: func [
    "Hides a dialog; closes a stream."
    target [object! handle!]
] [
    either object? target [target/hidden: true] [close-stream target]
]

toast: func [
    "Shows a short notice that goes away by itself."
    message [string!]
    /role "primary, success, warning or danger"
        kind [word!]
] [
    show-toast message either role [kind] [none]
]

theme: func [
    "Sets the theme from a few parameters."
    spec [block!]
] [
    apply-theme construct spec
]

; --- walking faces -------------------------------------------------------------

all-faces: function [f] [
    out: copy []
    collect-faces f out
    out
]

collect-faces: function [f out] [
    append out f
    if f/children [foreach c f/children [collect-faces c out]]
]

; Faces that belong to a scope: nested forms keep their own fields and submits.
own-faces: function [scope] [
    out: reduce [scope]
    if scope/children [foreach c scope/children [collect-own c out]]
    out
]

collect-own: function [f out] [
    append out f
    if all [f/children  f/style <> 'form] [foreach c f/children [collect-own c out]]
]

named-faces: function [scope] [
    out: copy []
    foreach f all-faces scope [if f/name [append out f]]
    out
]

form-values: function [
    "The values of the named fields of a form (or view), as a map."
    scope
] [
    m: make map! []
    foreach f named-faces scope [poke m f/name f/value]
    m
]

set-values: function [
    "Fills the named fields of a form (or view) from a map or object; none clears them."
    scope data [map! object! none!]
] [
    foreach f named-faces scope [
        v: either data [select data f/name] [none]
        f/value: either logic-face? f [true = v] [v]
        f/touched: false
        f/async-error: none
    ]
    refresh-form scope
]

; --- validation ------------------------------------------------------------------

messages: make map! [
    required "This field is required"
    email "Enter a valid email address"
    url "Enter a valid web address"
    integer "Enter a whole number"
    date "Enter a valid date"
    min "Must be at least #1"
    max "Must be at most #1"
    length "Must be between #1 and #2 characters"
    length-exact "Must be exactly #1 characters"
    pattern "This value is not valid"
    match "Must match #1"
    check "This value is not valid"
]

message: function [key args [block!]] [
    out: copy select messages key
    repeat i length? args [replace out rejoin ["#" i] form pick args i]
    out
]

digit: charset "0123456789"
word-char: charset [#"a" - #"z" #"A" - #"Z" #"0" - #"9" "._%+-"]
host-char: charset [#"a" - #"z" #"A" - #"Z" #"0" - #"9" "-"]
email-rule: [some word-char "@" some host-char some ["." some host-char] end]
url-rule: [["http://" | "https://"] some host-char any ["." some host-char] opt [":" some digit] opt ["/" to end] end]

; check and toggle hold true or false
logic-face?: func [f] [to logic! find [check toggle] f/style]

blank?: func [v] [
    any [none? :v  all [string? :v  empty? trim copy v]]
]

label-of: func [f] [any [f/text  form f/name]]

; The message for the first rule a face breaks, or none. Asynchronous checks
; are skipped here: their last result is kept in async-error.
validate-face: function [
    "Checks a face's rules; returns a message or none."
    f
] [
    v: f/value
    rules: any [f/rules []]
    if blank? :v [
        return either find/only rules [required] [message 'required []] [none]
    ]
    if all [logic-face? f  find/only rules [required]  not v] [return message 'required []]
    foreach r rules [
        problem: switch first r [
            email [unless parse v email-rule [message 'email []]]
            url [unless parse v url-rule [message 'url []]]
            integer [unless parse form v [opt "-" some digit] [message 'integer []]]
            date [unless date? attempt [to date! v] [message 'date []]]
            min [if all [number? v  v < r/2] [message 'min reduce [r/2]]]
            max [if all [number? v  v > r/2] [message 'max reduce [r/2]]]
            length [
                n: length? form v
                if any [n < r/2  n > r/3] [
                    either r/2 = r/3 [message 'length-exact reduce [r/2]] [message 'length reduce [r/2 r/3]]
                ]
            ]
            pattern [unless parse form v r/2 [message 'pattern []]]
            match [
                other: find-named f r/2
                if all [other  v <> other/value] [message 'match reduce [label-of other]]
            ]
            check [check-result run-handler f r/2]
        ]
        if problem [return problem]
    ]
    f/async-error
]

check-result: func [result] [
    case [
        string? :result [result]
        any [none? :result  false = :result] [message 'check []]
        true [none]
    ]
]

find-named: function [f name] [
    scope: any [f/form f/root]
    foreach g named-faces scope [if g/name = name [return g]]
    none
]

; Runs asynchronous checks of a face (they may fetch).
check-async: function [f] [
    foreach r any [f/rules []] [
        if all [r/1 = 'check-async  not blank? f/value] [
            f/pending: true
            f/async-error: check-result run-handler f r/2
            f/pending: false
        ]
    ]
]

; Updates the errors of touched faces and enables submit buttons only when
; every field of the form is valid. A view checks only the faces outside its forms.
refresh-form: function [scope] [
    unless find [form view] scope/style [exit]
    ok: true
    faces: own-faces scope
    foreach f faces [
        if f/rules [
            problem: validate-face f
            f/error: either f/touched [problem] [none]
            if problem [ok: false]
        ]
    ]
    foreach f faces [if f/submit [f/disabled: not ok]]
]

; --- events --------------------------------------------------------------------
;
; The host calls these from DOM events, each in its own task.

; A handler block runs with face, value, values and every named field bound.
run-handler: function [f body [block!]] [
    scope: any [f/form f/root]
    words: compose [
        face: (f)
        value: (either word? f/value [to lit-word! f/value] [f/value])
        values: (form-values any [scope f])
    ]
    if find data-styles f/style [append words compose [row: (f/selected)]]
    if scope [
        foreach g named-faces scope [append words reduce [to set-word! g/name g]]
    ]
    ctx: make object! words
    do bind copy/deep body ctx
]

handler-for: function [f name] [
    all [f/events  select f/events name]
]

ui-input: function [
    "Called by the host when the user changes a field."
    f new
] [
    f/value: switch/default f/style [
        number [any [attempt [to decimal! new]  none]]
        check [to logic! new]
        toggle [to logic! new]
    ] [new]
    if f/style = 'number [
        if all [decimal? f/value  f/value = to integer! f/value] [f/value: to integer! f/value]
    ]
    f/async-error: none
    refresh-form any [f/form f/root]
    if f/action [run-handler f f/action]
    if h: handler-for f 'on-change [run-handler f h]
]

ui-blur: function [
    "Called by the host when the user leaves a field."
    f
] [
    f/touched: true
    check-async f
    refresh-form any [f/form f/root]
]

ui-click: function [
    "Called by the host when the user activates a button."
    f
] [
    if f/submit [
        scope: any [f/form f/root]
        faces: own-faces scope
        foreach g faces [if g/rules [g/touched: true]]
        foreach g faces [check-async g]
        refresh-form scope
        if f/disabled [exit]
    ]
    if f/action [run-handler f f/action]
]

ui-select: function [
    "Called by the host when the user chooses a row of a table or list."
    f row
] [
    f/selected: row
    if h: handler-for f 'on-select [run-handler f h]
]

ui-close: function [
    "Called by the host when the user dismisses a dialog."
    f
] [
    f/hidden: true
    if h: handler-for f 'on-close [run-handler f h]
]
