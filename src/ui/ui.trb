Trebol [
    title: "UI dialect: faces, styles, layout and validation"
    exports: [
        face styles stylize rule add-rule ui-problem layout view theme looks open close toast confirm print-page
        validate-face field-error form-values set-values insert-text ui-pane ui-input ui-files ui-remove-file ui-lookup-search ui-lookup-pick ui-lookup-remove ui-blur ui-click ui-select ui-sort ui-close ui-event ui-menu ui-drop ui-reorder ui-crumb ui-expand ui-orbit ui-palette ui-palette-pick ui-toast-undo ui-toast-gone ui-toasts-done ui-toasts-on ui-step ui-step-go
        go go-back go-forward can-go-back? can-go-forward? unsaved unsaved? ui-route set-language ui-rows ui-board ui-check ui-sketch ui-dialect-words ui-react ui-style-defs
    ]
    parts: [
        %dialect/faces.trb
        %dialect/words.trb
        %dialect/takes.trb
        %dialect/styles.trb
        %dialect/styles-more.trb
        %dialect/problems.trb
        %dialect/layout.trb
        %dialect/steps.trb
        %dialect/view.trb
        %dialect/screens.trb
        %dialect/walking.trb
        %dialect/rows.trb
        %dialect/reactions.trb
        %dialect/palette.trb
        %dialect/validation.trb
        %dialect/events.trb
    ]
]

; The dialect is in the files of its parts, which run in this order and share the words of this
; module: faces, the words of the dialect, what a style takes and the styles, problems in a layout,
; laying out, steps, the blocks faces take and view, screens, walking faces, rows, reactions, the
; palette, validation, and the events the host passes on.
