Trebol [
    title: "UI dialect: faces, styles, layout and validation"
    exports: [
        face styles stylize layout view theme looks open close toast confirm print-page
        validate-face field-error form-values set-values insert-text ui-pane ui-input ui-files ui-remove-file ui-lookup-search ui-lookup-pick ui-lookup-remove ui-blur ui-click ui-select ui-sort ui-close ui-event ui-menu ui-drop ui-reorder ui-crumb ui-expand ui-orbit ui-palette ui-palette-pick
        go go-back go-forward can-go-back? can-go-forward? unsaved unsaved? ui-route set-language ui-rows ui-check ui-react
    ]
]

; --- faces ---------------------------------------------------------------------
;
; A face is an object. The host keeps one DOM node per face and copies these
; fields to it after every scheduler slice, so code changes a face by
; setting a field: `total/text: "42"`.

face: make object! [
    style: 'face        ; what the host renders
    name: none          ; field name: the key in `values`, and a word in handlers
    text: none          ; label, caption or content
    value: none         ; a field's value; also a progress (0-1 or percent) or an image (file or url)
    hint: none          ; placeholder
    role: none          ; primary accent danger success warning muted
    size: none          ; small medium large
    align: none         ; left center right spread
    valign: none        ; a row's children, top middle bottom; none lines them up on the controls
    cols: none          ; columns of a grid: a number, or the weight of each [1 4 1]
    icon: none
    fill: false
    fit: false          ; takes the height the window has left, and its children scroll inside
    pad: none           ; inner and between-children spacing, a step of the spacing scale (0-7)
    gap: none
    narrow-only: false  ; shown only on narrow screens
    wide-only: false    ; hidden on narrow screens
    hidden: false
    disabled: false
    readonly: false     ; shown and sent, but the user cannot change it, and no rule applies
    inert: false        ; shown as it is, but neither it nor its children can be used
    linked: false       ; a tile that stands for something kept elsewhere: marked with an arrow
    round: false        ; an image: cut to a circle, as for a person's photo
    tag: none           ; a widget: the name of the element it is, as the page's JavaScript defines it
    props: none         ; a widget: the element's properties, an object
    poster: none        ; a video: the image shown before it plays
    captions: none      ; a video: its captions, a .vtt file, or a block of one per language [en %a.vtt es %b.vtt]
    looping: false      ; a video or a sound starts again when it ends (loop in the dialect)
    silent: false       ; a video or a sound plays without its sound (muted in the dialect)
    autoplay: false     ; a video or a sound plays on its own, always silent, as browsers allow
    drag: false         ; can be dragged: carries its value, or the row in a table, list or tree
    drop: false         ; accepts drops (on-drop)
    reorder: false      ; its children or rows can be moved around (on-reorder)
    rules: none         ; validation: a block of [rule args...] blocks
    error: none         ; current message, shown once the face is touched
    touched: false
    pending: false      ; an asynchronous check is running
    sent: none          ; an upload or photo: how far its files went up, 0-1; none hides the bar
    async-error: none   ; result of the last asynchronous check
    action: none        ; the block after the face: click, change
    events: none        ; [on-change [...] on-select [...]]
    shortcut: none      ; a key that activates a button or link: "Ctrl+S"
    menu: none          ; context menu (or the menu a button opens): a block of menu items; on-menu runs
    options: none       ; choices of a choice or radio; what a lookup's search found
    known: none         ; a lookup: what each value shows as, a map; a value not in it shows as itself
    links: none         ; a lookup: the screen each value links to when readonly, a map
    query: none         ; a lookup: the text last searched for
    currency: none      ; a money field's currency code: EUR
    reactions: none     ; react, is and calc: a block of reaction objects
    template: none      ; rows: the block of the fields of one row
    built: none         ; rows: what its rows were last made from
    owner: none         ; a row of rows: the rows face it belongs to
    typed: none         ; what the user typed in a number, money or date field when it is not one;
                        ; in an upload or photo, the names of the files it refused
    multiple: false     ; an upload or a lookup takes more than one
    accept: none        ; the files an upload takes: ["pdf" "image/*"]; a photo, images unless told
    pane: none
    columns: none       ; table, list and tree: [field "Label" ...]; a column of images, [field ["Label" image round]]
    data: none          ; table, list and tree: a block of map! or object! rows (a tree's
                        ; have their own in `children`); breadcrumb: its items; orbit: its focus, nodes, edges and trail
    key: 'id            ; the row field that identifies a row
    morph: none         ; a name shared with a face of the next screen, which this one becomes as the screen
                        ; changes: a word, or a block of values; a table or list gives each row its name and key
    selected: none      ; the row last chosen
    sortable: false     ; a table the host sorts, from the rows it has, when a header is chosen
    sorted: none        ; a table: the order shown, [column asc] or [column desc]
    totals: none        ; a table: a row shown at the foot, never chosen nor sorted
    kind: none          ; a chart: bar line area pie
    stacked: false      ; a chart: its series one on top of another
    draw: none          ; a canvas: the block of the draw dialect it shows
    extent: none        ; a canvas: the size of its drawing space, a pair
    form: none          ; the enclosing form, if any
    root: none          ; the view this face belongs to
    place: none         ; where the face was written, file:line:col; none if made at run time
    submit: false
]

; style name -> prototype face
styles: make map! []

container-styles: [view column row form panel grid dialog scroll split toolbar desktop]
input-styles: [field password number money date area rich check toggle choice radio upload photo lookup rows widget]
data-styles: [table list tree chart]

foreach [name base] [
    view column  column column  row row  form form  panel panel  grid grid  scroll scroll  desktop desktop
    title title  heading heading  text text  divider divider
    field field  password password  number number  money money  date date  area area  rich rich  check check  choice choice
    toggle toggle  radio radio  upload upload  photo photo  lookup lookup  progress progress  image image  backdrop backdrop  icon icon
    video video  audio audio  widget widget
    button button  link link  tile tile  table table  list list  tabs tabs  tab tab
    toolbar toolbar  breadcrumb breadcrumb  tree tree  screens screens  screen screen  rows rows  entry entry
    canvas canvas  chart chart  orbit orbit
] [
    poke styles name make face [style: base]
]
poke styles 'view make face [style: 'view]
poke styles 'submit make face [style: 'button role: 'primary submit: true]
poke styles 'dialog make face [style: 'dialog hidden: true]
poke styles 'tabs make face [style: 'tabs value: 1]
poke styles 'screens make face [style: 'screens entering: false]   ; entering: the screen on show is still the old one
poke styles 'split make face [style: 'split value: 1]   ; value: the pane shown on narrow screens
poke styles 'canvas make face [style: 'canvas extent: 300x150]
poke styles 'chart make face [style: 'chart kind: 'bar]

stylize: function [
    "Defines styles from existing ones: name: base [field: value ...]"
    spec [block!]
] [
    parse spec [some [
        set name set-word! set base word! set defaults block! (
            proto: select styles base
            unless proto [do make error! rejoin ["stylize: unknown style " base ui-suggest base words-of styles]]
            poke styles to word! name make proto defaults
        )
    ]]
]

; --- layout --------------------------------------------------------------------

roles: [primary accent danger success warning muted]
sizes: [small medium large]
aligns: [left center right spread]
valigns: [top middle bottom]
flags: [fill fit hidden disabled readonly inert narrow-only wide-only linked round drag drop reorder multiple sortable stacked]
chart-kinds: [bar line area pie]
simple-rules: [required email url integer]
letter: charset [#"a" - #"z" #"A" - #"Z"]
rule-words: [min max length pattern match check check-async calc react is width pad gap menu accept known links sorted key morph poster captions]
media-styles: [video audio]
media-flags: [loop muted autoplay]   ; of a video or a sound

; Words that never name a field. email, url and integer are rules too,
; but also common field names, so the first word after an input style names it.
field-name?: func [w [word!]] [
    not any [
        find roles w  find sizes w  find aligns w  find flags w
        find rule-words w  w = 'required  event-word? w
    ]
]

add-rule: func [f rule [block!]] [
    unless f/rules [f/rules: copy []]
    append/only f/rules rule
]

event-word?: func [w [word!]] [
    to logic! find/match form w "on-"
]

; --- problems in a layout -------------------------------------------------------
;
; layout reads the whole block and makes one error of every problem it finds,
; each with the place it was loaded from (loaded-at) and a word it may mean.

; [place message ...] while a block is laid out; none otherwise, and then a problem is an error at once.
ui-problems: none

ui-problem: func [place [block!] message [string!]] [
    either ui-problems [append ui-problems reduce [place message]] [ui-fail reduce [place message]]
]

; The faces of a block, as build-faces gives them, or an error with every problem in it.
ui-build: function [spec [block!] labels [block!]] [
    outer: ui-problems
    set 'ui-problems copy []
    out: try [build-faces spec labels]
    found: ui-problems
    set 'ui-problems outer
    if error? out [do out]
    unless empty? found [either ui-checking [append ui-checking found] [ui-fail found]]
    out
]

; While ui-check runs: the problems of every block, and no code of the program is run.
ui-checking: none

; It lays out each block after view or layout (styles of stylize first), and the
; faces of each screen and row of rows, which a running app lays out only when shown.
ui-check: function [
    "Every problem in the layouts of a program, without running it: [place message ...]"
    code [block!]
    /local b p
] [
    set 'ui-checking copy []
    blocks: copy []
    ; the blocks after view, layout and stylize, in code and in the blocks inside it
    walk: function [code] [
        parse code [any [
            p: ['view | 'layout | 'stylize | path! if (find [view layout] first first p)]
            ; view compose [...]: its parens stand for values check cannot know
            opt ['compose | path! if ('compose = first first next p)]
            set b block! (
                append/only blocks reduce [first p b]
                walk b
            )
            | set b [block! | paren!] (walk b)
            | skip
        ]]
    ]
    walk code
    attempt-at: func [place body] [
        if error? r: try body [append ui-checking reduce [place form r/message]]
    ]
    foreach p blocks [if 'stylize = first p [attempt-at next p [stylize copy/deep second p]]]
    foreach p blocks [
        unless 'stylize = first p [
            attempt-at next p [
                faces: all-faces layout second p
                ; screens and rows lay these out when shown
                while [not empty? faces] [
                    f: take faces
                    later: copy []
                    if f/style = 'screens [foreach [n t a b] f/data [append/only later b]]
                    if all [f/style = 'rows  f/template] [append/only later f/template]
                    foreach b later [
                        spec: copy/deep b
                        parse spec [any [set w word! if (event-word? w) block!] body:]
                        foreach g ui-build body copy [] [append faces all-faces g]
                    ]
                ]
            ]
        ]
    ]
    ; a screen or rows laid out twice (rows with min) gives its problems twice
    found: copy []
    seen: copy []
    foreach [p m] ui-checking [
        k: rejoin [any [loaded-at p ""] " " m]
        unless find seen k [append seen k  append found reduce [p m]]
    ]
    set 'ui-checking none
    found
]

ui-fail: function [found [block!] /local place m] [
    either 2 = length? found [
        message: rejoin ["layout: " second found]
    ] [
        places: collect [foreach [place m] found [keep any [loaded-at place  ""]]]
        wide: 0
        foreach p places [wide: max wide length? p]
        message: rejoin ["layout: " (length? found) / 2 " problems"]
        i: 0
        foreach [place m] found [
            p: pick places i: i + 1
            append message rejoin ["^/   " p  append/dup copy "" #" " wide + 1 - length? p  m]
        ]
    ]
    e: make error! message
    ; the first values from the place, one after another as near shows them
    e/near: copy []
    foreach v copy/part first found 3 [append/only e/near :v]
    e/at: loaded-at first found
    do e
]

; What a rule word takes, for a problem when what follows it is something else.
ui-takes: [
    min "a number, an amount or a date"  max "a number, an amount or a date"  length "two integers"
    pattern "a block"  check "a block"  check-async "a block"  calc "a block"  react "a block, after later or not"  is "a block"  accept "a block"
    menu "a block"  sorted "a block"  known "a map"  links "a map"  match "the name of a field"
    poster "a file or a url"  captions "a file, a url or a block"  width "small, medium, large or fill"
    pad "a step from 0 to 7, none or wide"  gap "a step from 0 to 7, none or wide"  key "a text or a word"
    morph "a name, 'logo, or a block, [client id]"
]

; Every word the dialect knows, for ui-suggest.
ui-dialect-words: does [
    unique compose [
        (words-of styles) (roles) (sizes) (aligns) (valigns) (flags) (chart-kinds) (simple-rules)
        (rule-words) (media-flags) required global
    ]
]

; The word near enough to w to be what it meant (buton: button), or none.
ui-nearest: function [w [word!] words [block!]] [
    t: form w
    most: either 4 < length? t [2] [1]
    best: none
    foreach c words [
        d: ui-distance t form c
        if all [d > 0  d <= most] [best: c  most: d - 1]
    ]
    best
]

; "; did you mean button?" for buton, when one of the words is near enough; "" otherwise.
ui-suggest: function [w [word!] words [block!]] [
    either best: ui-nearest w words [rejoin ["; did you mean " best "?"]] [""]
]

; Optimal string alignment distance: letters put in, taken out, changed, or two neighbours swapped.
ui-distance: function [a [string!] b [string!]] [
    n: length? b
    before: none
    prev: copy []
    repeat j n + 1 [append prev j - 1]
    repeat i length? a [
        row: reduce [i]
        repeat j n [
            d: min min (pick prev j + 1) + 1  (last row) + 1  (pick prev j) + either (pick a i) = (pick b j) [0] [1]
            if all [i > 1  j > 1  (pick a i) = (pick b j - 1)  (pick a i - 1) = (pick b j)] [
                d: min d (pick before j - 1) + 1
            ]
            append row d
        ]
        before: prev
        prev: row
    ]
    last prev
]

; A value as a problem shows it: its mold, cut when long.
ui-shown: function [v] [
    t: mold :v
    either 30 < length? t [append copy/part t 27 "..."] [t]
]

; The style a word after a face means when it is a mistyped one (feild: field), or none.
ui-meant-style: function [v] [
    all [word? :v  s: ui-nearest v ui-dialect-words  select styles s  s]
]

; The problem with a value that follows a face and means nothing to it.
ui-stray: function [f v] [
    case [
        all [word? :v  t: select ui-takes v] [rejoin [v " takes " t]]
        s: ui-meant-style :v [rejoin [v " is not a style; did you mean " s "?"]]
        word? :v [rejoin [v " is not a word of " f/style ui-suggest v ui-dialect-words]]
        true [rejoin [f/style " does not take " ui-shown :v]]
    ]
]

; Labels (`search: field`, `table clients`) are local to the layout, as R3
; planned for its VID: each layout gets an object holding them, and the
; layout's blocks (its handlers too) are bound to it. `global search: field`
; sets a global word instead.

layout: function [
    "Turns a block of the UI dialect into a view face; /only gives the block of faces."
    spec [block!]
    /only "Return the faces, not a view holding them"
    /local ev b w
] [
    ; a copy, so laying out the same block twice never shares bindings
    spec: copy/deep spec
    labels: copy []
    either only [
        out: ui-build spec labels
    ] [
        ; on-xxx handlers and its width before the first face belong to the view itself
        events: copy []
        width: none
        parse spec [any [
            set ev word! if (event-word? ev) set b block! (append events reduce [ev b])
            | 'width set w ['small | 'medium | 'large | 'fill] (width: w)
        ] body:]
        out: make select styles 'view [pane: ui-build body labels]
        unless empty? events [out/events: events]
        out/size: width
    ]
    bind-labels spec labels copy []
    morphs either only [out] [reduce [out]]
    out
]

; Binds a laid-out block to an object of its labels and the given [word: value ...].
bind-labels: function [spec [block!] labels [block!] words [block!] /local w f] [
    foreach [w f] labels [append words reduce [to set-word! w f]]
    unless empty? words [bind spec make object! words]
]

; Works out the morph names given as blocks once the layout's words are bound: in
; [client id] the first word is the name as written, and what follows is evaluated.
morphs: function [faces [block!]] [
    if ui-checking [exit]
    foreach f faces [foreach g all-faces f [
        if all [block? m: g/morph  not empty? m  word? first m] [g/morph: append reduce [first m] reduce next m]
    ]]
]

; Keeps a label for a face: in the layout's labels, or as a global word.
label-face: function [label labels [block!] global? [logic!] f] [
    either global? [set label f] [
        w: to word! label
        either p: find/skip labels w 2 [p/2: f] [append labels reduce [w f]]
    ]
]

; A text of the interface: a string, a text per language (a map), or a word of
; the dictionary written as a lit-word ('save). Faces keep it as given and the
; host shows it in the active language, so set-language translates them.
text-rule: [string! | map! | lit-word!]
text-of: func [t] [either lit-word? :t [to word! t] [t]]

; The faces of a block of the dialect; labels collects [word face ...].
build-faces: function [
    spec [block!] labels [block!]
    /local label global? style-word f proto n s b w a i v ev p pos later
] [
    out: copy []
    ; what starts the next face
    face-start: [set-word! | 'global | set w word! if (select styles w)]
    modifier: [
        ; ui-check reads view compose [...] with its parens in it: menu (looks)
        if (ui-checking) opt [set w word! if (select ui-takes w)] some paren!
        | set s [string! | map!] (either f/text [f/hint: s] [f/text: s])
        ; a word of the dictionary: button 'save (in a link, a lit-word is the screen)
        | if (f/style <> 'link) set v lit-word! (v: to word! v  either f/text [f/hint: v] [f/text: v])
        | set ev word! if (event-word? ev) set b block! (
            unless f/events [f/events: copy []]
            append f/events reduce [ev b]
        )
        | pos: set b block! (
            case [
                ; grid [1 4 1] [...]: the weight of each column, then the children
                all [f/style = 'grid  none? f/pane  not empty? b  parse b [some integer!]] [f/cols: b]
                ; rows items [...]: the fields of a row; a second block is the action
                all [f/style = 'rows  none? f/template] [f/template: b]
                find container-styles f/style [
                    ; --- in a toolbar is a separator
                    f/pane: build-faces either f/style = 'toolbar [replace/all copy b '--- 'divider] [b] labels
                    if all [f/style = 'split  2 <> length? f/pane] [
                        ui-problem pos "split takes two faces, one per pane"
                    ]
                ]
                find data-styles f/style [f/columns: columns-of b]
                ; the first block holds the items, the second is the action
                all [f/style = 'breadcrumb  none? f/data] [f/data: crumbs-of b]
                ; orbit [focus ... nodes [...]]: what it shows; a second block is the action
                all [f/style = 'orbit  none? f/data] [f/data: orbit-of b]
                ; widget <geo-map> [zoom: 12]: its properties; a second block is the action
                all [f/style = 'widget  none? f/props] [f/props: either ui-checking [make object! []] [make object! b]]
                f/style = 'canvas [f/draw: b]
                f/style = 'tabs [f/pane: tabs-of b labels]
                f/style = 'screens [f/data: screens-of b]
                all [find [choice radio] f/style  none? f/options] [f/options: options-of b]
                true [f/action: b]
            ]
        )
        | set i issue! (f/icon: i)
        | set v [file! | url! | percent!] (f/value: v)
        ; a link to a screen: link "Clients" 'clients, link "Ada" 'client/42
        | set v lit-word! (f/value: to word! v)
        | set v lit-path! (f/value: to path! v)
        | set n integer! (f/cols: n)
        | set p pair! (f/extent: p)
        | set w word! if (all [f/style = 'chart  find chart-kinds w]) (f/kind: w)
        | 'min set n [number! | money! | date!] (add-rule f reduce ['min n])
        | 'max set n [number! | money! | date!] (add-rule f reduce ['max n])
        | 'length set a integer! set n integer! (add-rule f reduce ['length a n])
        | 'pattern set b block! (add-rule f reduce ['pattern b])
        | 'accept set b block! (f/accept: b)
        | 'poster set v [file! | url!] (f/poster: v)
        | 'captions set v [file! | url! | block!] (f/captions: v)
        ; muted names a role elsewhere, and loop a function, so a video keeps them in fields of its own
        | set w word! if (all [find media-flags w  find media-styles f/style]) (
            poke f select [muted silent loop looping autoplay autoplay] w true
        )
        | 'known set v map! (f/known: v)
        | 'links set v map! (f/links: v)
        | 'match set w word! (add-rule f reduce ['match w])
        | 'check set b block! (add-rule f reduce ['check b])
        | 'check-async set b block! (add-rule f reduce ['check-async b])
        | 'calc set b block! (add-reaction f 'calc b false  f/readonly: true)
        | 'is set b block! (add-reaction f 'is b false)
        | 'react (later: false) opt ['later (later: true)] set b block! (add-reaction f 'react b later)
        | 'width set w word! (f/size: w)
        | pos: set w ['pad | 'gap] [set n integer! | 'none (n: 0) | 'wide (n: 6)] (poke f w spacing n pos)
        | 'menu set b block! (f/menu: menu-of b)
        | 'morph set v [lit-word! | block!] (f/morph: either block? v [v] [to word! v])
        | 'key set s string! (f/shortcut: s)
        | 'key set w word! (f/key: w)
        | 'sorted set b block! (f/sorted: sort-order b)
        | set w word! if (find roles w) (f/role: w)
        | set w word! if (find sizes w) (f/size: w)
        | set w word! if (find aligns w) (f/align: w)
        | set w word! if (all [f/style = 'row  find valigns w]) (f/valign: w)
        | set w word! if (find flags w) (poke f w true)
        | set w word! if (find simple-rules w) (add-rule f reduce [w])
        ; money price "Price" EUR
        | set w word! if (all [f/style = 'money  parse form w [3 letter]]) (f/currency: to word! uppercase form w)
    ]
    parse spec [any [
        (label: none  global?: false)
        opt ['global (global?: true)]
        opt [set label set-word!]
        [
            ; a face that compose puts in: check takes what follows as words of a face it cannot know
            if (ui-checking) paren! (f: make face []) any modifier
        |   pos: set style-word word! if (proto: select styles style-word) (
                f: make proto []
                f/place: loaded-at pos
                append out f
                if label [label-face label labels global? f]
            )
            ; widget <geo-map> place "Place": the element comes before the name
            opt [if (f/style = 'widget) set v tag! (f/tag: to string! v)]
            opt [if (find input-styles f/style) set n word! if (field-name? n) (f/name: n)]
            ; chart bar income [...]: the kind comes before the label
            opt [if (f/style = 'chart) set n word! if (find chart-kinds n) (f/kind: n)]
            ; table clients [...] is the same as clients: table [...]
            opt [if (any [find data-styles f/style  f/style = 'orbit]) set n word! if (field-name? n) (label-face n labels global? f)]
            any [
                modifier
                ; a mistyped style starts a face of its own: what follows it is that face's
                | pos: not face-start skip (ui-problem pos ui-stray f first pos) opt [
                    if (ui-meant-style first pos) any [not face-start skip]
                ]
            ]
            (if f/style = 'rows [rows-fill f])
            ; not a style: a problem, then on to the next face
        |   pos: skip (
                w: first pos
                ui-problem pos case [
                    not word? :w [rejoin ["a face starts with a style, not " ui-shown :w]]
                    find ui-dialect-words w [rejoin [w " is not a style; it goes after one"]]
                    true [rejoin [w " is not a style" ui-suggest w words-of styles]]
                ]
            ) any [not face-start skip]
        ]
    ]]
    out
]

spacing: func [n [integer!] place [block!]] [
    if all [n >= 0  n <= 7] [return n]
    ui-problem place rejoin [first place " takes a step from 0 to 7"]
    0
]

; [name "Name" email] -> [name "Name" email "email"]
; A column of images keeps what it is with its label: [photo "" image round] -> [photo ["" image round]]
columns-of: function [spec [block!] /local w label kind p] [
    out: copy []
    parse spec [any [
        set w word! (label: form w  kind: none) opt [set label text-rule]
        opt ['image (kind: copy [image]) opt ['round (append kind 'round)]]
        (
            label: text-of label
            append out w
            append/only out either kind [head insert/only kind label] [label]
        )
        | p: skip (ui-problem p "table columns are words, each with an optional label, then image or image round") to end
    ]]
    out
]

; [name desc] -> [name desc], checked
sort-order: function [b [block!]] [
    unless parse b [word! ['asc | 'desc]] [ui-problem b "sorted takes a column and asc or desc"]
    copy b
]

; ["General" [...] "Advanced" [...]] -> a tab face per pair
tabs-of: function [spec [block!] labels [block!] /local p] [
    out: copy []
    parse spec [any [
        set label text-rule set b block! (
            label: text-of label
            append out make select styles 'tab [text: label pane: build-faces b labels]
        )
        | p: skip (ui-problem p "tabs take a label and a block per tab") to end
    ]]
    out
]

; [home "Home" [...] client "Client" [id] [...]] -> [name title args body ...]
screens-of: function [spec [block!] /local n t a b p] [
    out: copy []
    if empty? spec [ui-problem spec "screens take a name, a title, an optional block of arguments and a block per screen"]
    parse spec [any [
        set n word! set t text-rule (a: copy []) opt [ahead [block! block!] set a block!] set b block! (
            forall a [unless word? first a [ui-problem a "the arguments of a screen are words"]]
            append out reduce [n text-of t head a b]
        )
        | p: skip (ui-problem p "screens take a name, a title, an optional block of arguments and a block per screen") to end
    ]]
    out
]

menu-item: make object! [
    text: none
    icon: none
    id: none            ; the word on-menu gets in event/picked
    items: none         ; a submenu
    divider: false
]

; As in Red: ["Edit" edit #trash "Delete" delete --- "Move to" ["Top" top]] -> menu items
menu-of: function [spec [block!] /local i label w b p] [
    out: copy []
    parse spec [any [
        '--- (append out make menu-item [divider: true])
        | (i: none) opt [set i issue!] set label text-rule (label: text-of label) [
            set b block! (append out make menu-item [text: label icon: i items: menu-of b])
            | set w word! (append out make menu-item [text: label icon: i id: w])
        ]
        | p: skip (ui-problem p "a menu takes a label and a word per item, a block for a submenu, or ---") to end
    ]]
    out
]

; [focus id  nodes [id "Title" [hints] ...]  edges [from to "Label" [dashed] ...]  trail [id ...]]
; The host reads the hints (a role or color, many, dashed, count n, steps n at k); this checks the shape.
orbit-id: [word! | integer! | string! | issue!]
orbit-of: function [spec [block!] /local b p] [
    parse spec [any [
        'focus orbit-id
        | 'nodes set b block! (parse b [
            any [orbit-id text-rule opt block!]
            [end | p: (ui-problem p "nodes takes an id and a title for each, then a block of hints if it has any")]
        ])
        | 'edges set b block! (parse b [
            any [orbit-id orbit-id opt text-rule opt [into ['solid | 'dashed | 'faint]]]
            [end | p: (ui-problem p "edges takes two ids for each, then a label and [solid], [dashed] or [faint] if it has them")]
        ])
        | 'trail set b block! (parse b [
            any orbit-id [end | p: (ui-problem p "trail takes the ids of nodes, the most recent last")]
        ])
        | p: skip (ui-problem p "an orbit takes focus id, nodes [...], edges [...] and trail [...]") to end
    ]]
    copy spec
]

; ["Home" home "Clients" clients "Ada"]: a label and a word per item; the last one may have no word
crumbs-of: function [spec [block!] /local label w p] [
    parse spec [
        any [set label [string! | map!] set w [word! | path!]] opt [string! | map!]
        [end | p: (ui-problem p "a breadcrumb takes a label and a word per item; only the last may have no word")]
    ]
    copy spec
]

; The options of a choice or radio: each reduced, and so are those of a group,
; a title followed by a block: ["Bikes" ["Road" "City"] "Other"].
options-of: function [spec [block!]] [
    if ui-checking [return copy spec]
    opts: reduce spec
    forall opts [if block? first opts [change/only opts reduce first opts]]
    opts
]

; Links each face to its view and form, so handlers can find `values`.
attach: function [f root form] [
    f/root: root
    f/form: form
    if f/pane [
        inner: either find [form entry] f/style [f] [form]
        foreach c f/pane [attach c root inner]
    ]
]

view: function [
    "Shows a layout (a block of the dialect, or a face from layout) as the page."
    spec [block! object!]
] [
    root: either block? spec [layout spec] [spec]
    attach root root none
    set 'page root
    entered: copy []
    foreach f all-faces root [
        if f/style = 'screens [
            set 'router f
            append entered follow-link f route
        ]
    ]
    foreach f all-faces root [refresh-form f]
    show root
    foreach s entered [run-enter s]
    root
]

; --- screens -------------------------------------------------------------------
;
; A screens face shows one screen at a time and keeps the page's link in step:
; the screen `client [id]` showing id "42" is #/client/42. A route is a block
; of the screen name and its arguments as strings, as they come in the link.

router: none        ; the screens face of the page
marked: false       ; the screen on show has changes not saved (unsaved)
page: none          ; the root face of the view on show

; The [name title args body] of the screen a route names, or none.
find-screen: function [f route [block!] /local n t a b] [
    if any [empty? route  not word? first route] [return none]
    foreach [n t a b] f/data [
        if all [n = first route  (length? a) = ((length? route) - 1)] [return reduce [n t a b]]
    ]
    none
]

; Builds the screen a route names as the only child of f; returns the screen face.
enter-screen: function [f route [block!] /local ev b] [
    def: find-screen f route
    ; a screen's arguments and labels are local to it
    spec: copy/deep def/4
    labels: copy []
    ; on-xxx handlers before the first face belong to the screen
    events: copy []
    parse spec [any [set ev word! if (event-word? ev) set b block! (append events reduce [ev b])] body:]
    s: make select styles 'screen [text: def/2  pane: ui-build body labels]
    unless empty? events [s/events: events]
    words: copy []
    repeat i length? def/3 [append words reduce [to set-word! pick def/3 i  pick route i + 1]]
    bind-labels spec labels words
    morphs reduce [s]
    f/value: copy route
    f/entering: true
    ; what cached kept is asked again as the new screen reads it
    ui-caches-old
    ; a screen starts with nothing to save
    set 'marked false
    set-unsaved false
    f/pane: reduce [s]
    ui-pane f
    s
]

; Runs what a screen does on entering, and only then lets the host show it: the
; page keeps the screen it had until the new one has its data, so nothing paints
; half made; if that takes long, the host shows the new one with gray bars where
; its data will be. If on-enter went elsewhere, the screen it went to decides.
run-enter: function [s] [
    r: none
    if h: handler-for s 'on-enter [r: try [run-handler s h  none]]
    if same? s first router/pane [
        router/entering: false
        ; the screen on show changed, and so may whether back and forward can be used
        if h: handler-for router 'on-change [run-handler router h]
    ]
    if error? :r [do :r]
]

; Whether the screen on show lets the page leave it: its on-leave says, false or
; 'continue (as Red's on-close) to stay; with no on-leave, a screen with unsaved
; changes asks the user. Both may wait for a dialog.
may-leave?: function [/local s h r] [
    unless all [router  s: first router/pane] [return true]
    if h: handler-for s 'on-leave [
        r: run-handler s h
        return not any [false = :r  'continue = :r]
    ]
    any [
        not marked
        confirm/with/role select i18n/ui 'leave-unsaved reduce [select i18n/ui 'leave select i18n/ui 'stay] 'danger
    ]
]

; Shows the screen of a link given as a block of strings; a link that names no
; screen shows the first one and is replaced by its link.
follow-link: function [f parts [block!]] [
    route: copy parts
    unless empty? route [route/1: attempt [to word! route/1]]
    unless find-screen f route [
        route: reduce [first f/data]
        set-route route true
    ]
    enter-screen f route
]

go: function [
    "Shows a screen and gives the page its link: go 'clients, go [client row/id] (the name is not evaluated, the arguments are)."
    target [word! block! path!]
] [
    unless router [do make error! "go: the view has no screens"]
    route: reduce [either word? target [target] [first target]]
    if block? target [foreach a reduce next target [append route form a]]
    if path? target [foreach a next to block! target [append route form a]]
    unless find-screen router route [do make error! rejoin ["go: no screen for " mold route]]
    unless may-leave? [exit]
    set-route route false
    run-enter enter-screen router route
]

go-back: function [
    "Returns to the screen the user came from; if they came from outside the page, goes to target."
    target [word! block! path!]
] [
    unless route-back [go target]
]

go-forward: function [
    "Goes to the screen the user came back from, if there is one; true if it went."
] [
    route-forward
]

can-go-back?: function [
    "True if a screen of this page lies behind the current one in the browser's history."
] [
    0 < first route-steps
]

can-go-forward?: function [
    "True if a screen of this page lies ahead of the current one: the user went back and has not gone elsewhere since."
] [
    0 < second route-steps
]

unsaved: function [
    "Marks the screen on show as having changes not saved, or not: leaving it asks first, and so does closing the page."
    on [logic!]
] [
    set 'marked on
    set-unsaved on
]

unsaved?: function [
    "True if the screen on show has changes not saved (unsaved)."
] [
    marked
]

ui-route: function [
    "Called by the host when the page's link changes: back, forward or a link."
    f parts [block!]
] [
    route: copy parts
    unless empty? route [route/1: attempt [to word! route/1]]
    if route = f/value [exit]
    ; the link has changed already: staying puts the screen's link back
    unless may-leave? [route-undo  exit]
    run-enter follow-link f parts
]

ui-pane: function [
    "Called by the host when code gave a face a new pane: links the new faces to their view and form."
    f
] [
    inner: either find [form entry] f/style [f] [f/form]
    foreach c any [f/pane []] [attach c f/root inner]
    unless f/root [exit]
    refresh-form any [inner f/root]
    ; and the forms among the new faces, whose submits start disabled until their fields are valid
    foreach c any [f/pane []] [foreach g all-faces c [if g/style = 'form [refresh-form g]]]
]

open: func [
    "Shows a dialog."
    dialog [object!]
] [
    dialog/hidden: false
]

close: func [
    "Hides a dialog; closes a stream."
    target [object! handle!]
] [
    either object? target [target/hidden: true] [close-stream target]
]

toast: func [
    "Shows a short notice that goes away by itself."
    message [string! map! word!] "A text, a text per language, or a word of the dictionary"
    /role "primary, success, warning or danger"
        kind [word!]
] [
    show-toast tr message either role [kind] [none]
]

confirm: func [
    "Asks a question in a small dialog and waits: true when the user says yes."
    question [string! map! word!] "A text, a text per language, or a word of the dictionary"
    /with "The answers, yes first"
        choices [block!]
    /role "primary (the default) or danger, for what cannot be undone"
        kind [word!]
] [
    show-confirm tr question
        either with [tr first choices] [none]
        either with [tr second choices] [none]
        either role [kind] [none]
]

print-page: func [
    "Opens the browser's print dialog for the screen."
    /only "Print just this face and what is inside it"
        face [object!]
] [
    print-faces either only [face] [none]
]

set-language: func [
    "Changes the active language and shows every face again in it."
    language [word! string!]
] [
    i18n/language: either string? language [to word! language] [language]
    ; the messages under the fields were written in the language before
    if page [foreach f all-faces page [refresh-form f]]
    repaint
]

; The looks of src/host/theme.ts, with their names: colors, shapes, fonts, shadows and
; how the icons are drawn go together. As they are, they make the items of a menu.
looks: [
    #(en: "Minimal" es: "Minimalista") minimal
    #(en: "Paper" es: "Papel") paper
    #(en: "Civic" es: "Institucional") civic
    #(en: "Soft" es: "Amable") soft
    #(en: "Ink" es: "Tinta") ink
    #(en: "Classic" es: "Clásico") classic
    #(en: "Cupertino" es: "Cupertino") cupertino
    #(en: "Fusion" es: "Fusion") fusion
    #(en: "Fluent" es: "Fluent") fluent
]

theme: func [
    "Sets the theme: a look by name (theme 'civic), or parameters (theme [look: civic base: 200 mode: dark])."
    spec [block! word!]
] [
    apply-theme construct either word? spec [reduce [to set-word! 'look spec]] [spec]
]

; --- walking faces -------------------------------------------------------------

all-faces: function [f] [
    out: copy []
    collect-faces f out
    out
]

collect-faces: function [f out] [
    append out f
    if f/pane [foreach c f/pane [collect-faces c out]]
]

; Faces that belong to a scope: nested forms keep their own fields and submits.
own-faces: function [scope] [
    out: reduce [scope]
    if scope/pane [foreach c scope/pane [collect-own c out]]
    out
]

collect-own: function [f out] [
    append out f
    if all [f/pane  f/style <> 'form] [foreach c f/pane [collect-own c out]]
]

; The fields of a row are not fields of the form: rows holds their values.
named-faces: function [scope] [
    out: copy []
    collect-named scope out
    out
]

collect-named: function [f out] [
    if f/name [append out f]
    if all [f/pane  f/style <> 'rows] [foreach c f/pane [collect-named c out]]
]

form-values: function [
    "The values of the named fields of a form (or view), as a map."
    scope
] [
    m: make map! []
    foreach f named-faces scope [poke m f/name f/value]
    m
]

set-values: function [
    "Fills the named fields of a form (or view) from a map or object; none clears them."
    scope data [map! object! none!]
] [
    foreach f named-faces scope [
        v: either data [select data f/name] [none]
        f/value: either logic-face? f [true = v] [v]
        f/touched: false
        f/typed: none
        f/async-error: none
        if f/style = 'rows [
            f/built: none
            rows-fill f
        ]
    ]
    refresh-form scope
]

insert-text: function [
    "Puts text where the cursor of a field, area or rich text was last, in place of what was selected, as if the user typed it."
    face [object!]
    text [string!]
] [
    unless find [field area rich] face/style [
        do make error! rejoin ["insert-text: a " face/style " has no cursor"]
    ]
    if any [face/readonly  face/disabled  empty? text] [exit]
    ; the host gives the value with the text in; at its end when the face has had no cursor
    ui-input face insert-at-caret face text
    face
]

field-error: function [
    "Shows a message on a named field until the user changes it: what a server refused. False if there is no such field."
    scope name [word! string!] text [string!]
] [
    name: to word! name
    foreach f named-faces scope [
        if f/name = name [
            f/async-error: text
            f/error: text
            f/touched: true
            refresh-form scope
            return true
        ]
    ]
    false
]

; --- rows ------------------------------------------------------------------------
;
; A field made of rows the user adds and removes. Its pane is an entry per row
; and the add button last; an entry holds the fields of the template and its
; remove button. Each entry is a scope of its own, so `values` in a handler or
; a formula of a row is that row. The value is a block with a map per row, or
; none when there are no rows; code changes the rows by assigning it.

last-entry: 0

rule-of: function [f name [word!]] [
    foreach r any [f/rules []] [if r/1 = name [return r/2]]
    none
]

entries-of: function [f] [
    collect [foreach c any [f/pane []] [if c/style = 'entry [keep c]]]
]

rows-entry: function [f data] [
    spec: copy/deep f/template
    labels: copy []
    set 'last-entry last-entry + 1
    e: make select styles 'entry [owner: f  value: last-entry]
    e/pane: ui-build spec labels
    bind-labels spec labels copy []
    foreach g named-faces e [
        if f/readonly [g/readonly: true]
        if f/disabled [g/disabled: true]
    ]
    if data [set-values e data]
    remove-button: make select styles 'button [icon: #trash]
    remove-button/hint: select i18n/ui 'remove-row
    remove-button/action: compose [rows-remove (f) (e/value)]
    append e/pane remove-button
    e
]

; Makes the rows again from the value, if it or the flags changed since they were made.
rows-fill: function [f] [
    state: reduce [f/value f/readonly f/disabled]
    if all [f/pane  state = f/built] [exit]
    entries: map-each d any [f/value []] [rows-entry f d]
    ; `min 2` starts with two empty rows
    while [(length? entries) < any [rule-of f 'min 0]] [append entries rows-entry f none]
    add-button: either f/pane [last f/pane] [
        make select styles 'button [icon: #plus]
    ]
    add-button/text: select i18n/ui 'add-row
    add-button/action: compose [rows-add (f)]
    f/pane: append entries add-button
    if f/root [foreach e entries [attach e f/root f/form]]
    rows-store f
]

; Takes the value from the rows and shows only the buttons that can be used.
rows-store: function [f] [
    entries: entries-of f
    n: length? entries
    f/value: either empty? entries [none] [map-each e entries [form-values e]]
    f/built: reduce [f/value f/readonly f/disabled]
    add-button: last f/pane
    add-button/hidden: f/readonly
    add-button/disabled: any [f/disabled  n >= any [rule-of f 'max n + 1]]
    foreach e entries [
        remove-button: last e/pane
        remove-button/hidden: f/readonly
        remove-button/disabled: any [f/disabled  n <= any [rule-of f 'min 0]]
    ]
]

; A field of a row changed: so did the value of its rows, and of the rows those are in.
store-around: function [f] [
    e: f/form
    if all [e  e/style = 'entry] [
        rows-store e/owner
        store-around e/owner
    ]
]

rows-add: function [f] [
    e: rows-entry f none
    attach e f/root f/form
    faces: copy f/pane
    insert back tail faces e
    f/pane: faces
    rows-store f
    f/touched: true
    changed f
]

rows-remove: function [f id] [
    faces: copy f/pane
    ; faces compare by content, so a row is found by its number
    forall faces [
        if faces/1/value = id [
            remove faces
            break
        ]
    ]
    f/pane: head faces
    rows-store f
    f/touched: true
    changed f
]

ui-rows: function [
    "Called by the host when code gave a rows face a new value or changed its flags."
    f
] [
    rows-fill f
    refresh-form any [f/form f/root]
]

; --- reactions -------------------------------------------------------------------
;
; `react [...]` after a face runs the block when the face is shown, and again
; whenever a facet it reads changes: `total/text`, `face/value`, `values/qty`.
; Which facets it reads is found by reading the block, not by running it. The
; host checks them at the end of each round, before it repaints, against what
; they were when the block last ran. `is [...]` gives the face's main facet what
; the block gives, and `calc [...]` its value, which the user cannot change.

reaction: make object! [
    kind: 'react        ; react, is or calc
    body: none
    later: false        ; runs on a change only, not when the face is shown
    sources: none       ; the [face facet ...] it reads, found the first time it is checked
    targets: none       ; the [face facet ...] it sets, so that it runs before what reads them
    last: none          ; what its sources were when it last ran
]

add-reaction: function [f k b l] [
    unless f/reactions [f/reactions: copy []]
    append f/reactions make reaction [kind: k  body: b  later: l]
]

value-styles: append copy input-styles [progress image video audio]

; The facet `is` sets: data for a table, list, tree or chart, a canvas's draw,
; an input's value, and text for the rest.
main-facet: func [f] [
    case [
        find data-styles f/style ['data]
        f/style = 'orbit ['data]
        f/style = 'canvas ['draw]
        find value-styles f/style ['value]
        true ['text]
    ]
]

face?: func [v] [all [object? :v  in v 'style  in v 'pane]]

; Puts in out the face and facet a path names: name/facet (a label), face/facet
; (the face itself), values/field (the value of the field of that name).
react-path: function [f p out [block!]] [
    w: first p
    unless all [word? :w  word? pick p 2] [exit]
    facet: second p
    g: case [
        w = 'face [f]
        w = 'values [facet: 'value  attempt [find-named f second p]]
        true [attempt [get w]]
    ]
    if all [face? :g  in g facet] [append out reduce [g facet]]
]

react-scan: function [f b [block! paren!] sources [block!] targets [block!] /local v] [
    forall b [
        v: first b
        case [
            any [block? :v  paren? :v] [react-scan f v sources targets]
            any [path? :v  get-path? :v] [react-path f v sources]
            set-path? :v [react-path f v targets]
            ; an answer kept: of its url if written out, else of any
            all [word? :v  v = 'cached] [
                append sources either any [url? second b  string? second b] [
                    reduce [ui-cache-entry second b 'version]
                ] [
                    reduce [ui-cache-news 'version]
                ]
            ]
        ]
    ]
]

react-now: function [r /local g facet] [
    out: copy []
    foreach [g facet] r/sources [append/only out select g facet]
    out
]

; Faces compare by content, so finding one in a block needs same?.
find-same: function [b [block!] v] [
    foreach x b [if same? x v [return true]]
    false
]

react-due?: func [r] [not strict-equal? r/last react-now r]

; True if a reaction sets something b reads.
feeds?: function [a b /local g m h n] [
    foreach [g m] a/targets [
        foreach [h n] b/sources [if all [same? g h  m = n] [return true]]
    ]
    false
]

react-run: function [f r] [
    if r/kind = 'react [
        run-handler f r/body
        exit
    ]
    m: either r/kind = 'calc ['value] [main-facet f]
    ; a formula that fails, or lacks a value, leaves the field empty
    v: either r/kind = 'calc [attempt [run-handler f r/body]] [run-handler f r/body]
    unless strict-equal? :v select f m [
        poke f m :v
        if m = 'value [store-around f]
    ]
]

ui-react: function [
    "Called by the host at the end of each round: runs the reactions of the faces whose facets they read changed. Gives the cycles it cut, as texts."
    faces [block! object!] "The faces, or a face to take every face in it"
    /local f r
] [
    if object? faces [faces: all-faces faces]
    fs: copy []
    rs: copy []
    foreach f faces [
        foreach r any [select f 'reactions []] [
            unless r/sources [
                r/sources: copy []
                r/targets: copy []
                react-scan f r/body r/sources r/targets
                if r/kind <> 'react [append r/targets reduce [f either r/kind = 'calc ['value] [main-facet f]]]
                ; none is never a list of values: due, so it runs when shown
                r/last: either r/later [react-now r] [none]
            ]
            append fs f
            append rs r
        ]
    ]
    cut: copy []
    failed: none
    ; a second cascade, for what the forms changed after the first (an error, a disabled submit)
    loop 2 [
        ran: copy []
        forever [
            due: copy []
            repeat i length? rs [if all [not find ran i  react-due? pick rs i] [append due i]]
            if empty? due [break]
            ; the first that no other one due feeds; if they all feed each other, the first
            i: first due
            foreach j due [
                ok: true
                foreach k due [if all [k <> j  feeds? pick rs k pick rs j] [ok: false  break]]
                if ok [i: j  break]
            ]
            r: pick rs i
            e: try [react-run pick fs i r  none]
            if all [error? :e  not failed] [failed: :e]
            r/last: react-now r
            append ran i
        ]
        if empty? ran [break]
        ; what reads again what changed after it ran is in a cycle: it waits for the next change
        foreach i ran [
            r: pick rs i
            if react-due? r [
                where: loaded-at r/body
                append cut rejoin [either where [rejoin [where " "]] [""] r/kind ": left out, what it reads changed again after it ran (a cycle)"]
                r/last: react-now r
            ]
        ]
        scopes: copy []
        foreach i ran [
            f: pick fs i
            s: any [f/form f/root]
            if all [s  not find-same scopes s] [append scopes s]
        ]
        foreach s scopes [refresh-form s]
    ]
    if failed [do :failed]
    cut
]

; --- the palette -----------------------------------------------------------------
;
; Ctrl+K opens a box that finds what the page can do: its screens without
; arguments, the buttons and links on show and the items of their menus, and
; what the view's on-find gives for the text typed (its value), as pairs of a
; label and a link, as a breadcrumb's.

; The faces on show in f, as the user sees them on a wide screen.
palette-walk: function [f out [block!]] [
    if any [f/hidden  f/narrow-only] [exit]
    append out f
    unless block? f/pane [exit]
    either f/style = 'tabs [
        repeat i length? f/pane [
            t: pick f/pane i
            if all [i = f/value  block? t/pane] [foreach c t/pane [palette-walk c out]]
        ]
    ] [
        foreach c f/pane [palette-walk c out]
    ]
]

; The items of a menu that match, with the labels of the menus they are in.
palette-menu: function [f items [block!] path [string!] match [function!] out [block!] /local i] [
    foreach i items [
        unless i/divider [
            label: rejoin [path " › " tr i/text]
            either i/items [palette-menu f i/items label :match out] [
                if match label [append out reduce [label 'menu none reduce [f i]]]
            ]
        ]
    ]
]

ui-palette: function [
    "Called by the host as the user types in the palette (Ctrl+K) of view v: label, kind, keys and target of each thing that matches the text."
    v [object!] text [string!]
    /local n t a b f
] [
    out: copy []
    match: func [label] [any [empty? text  find label text]]
    if router [
        foreach [n t a b] router/data [
            if empty? a [
                label: tr t
                if match label [append out reduce [label 'screen none n]]
            ]
        ]
    ]
    faces: copy []
    palette-walk v faces
    foreach f faces [
        if all [find [button link] f/style  not f/disabled] [
            label: any [all [f/text  tr f/text]  f/hint]
            if all [string? label  not empty? label] [
                either f/menu [palette-menu f f/menu label :match out] [
                    if match label [append out reduce [label 'action f/shortcut f]]
                ]
            ]
        ]
    ]
    if all [not empty? text  h: handler-for v 'on-find] [
        found: run-handler/given v h text
        if block? :found [foreach [label link] found [append out reduce [tr label 'found none :link]]]
    ]
    out
]

ui-palette-pick: function [
    "Called by the host when the user chooses in the palette of view v: goes to a screen or link, or chooses a menu item."
    v [object!] kind [word!] target
] [
    switch kind [
        screen found [go :target]
        menu [ui-menu target/1 target/2 none]
    ]
]

; --- validation ------------------------------------------------------------------

message: function [key args [block!]] [
    out: copy tr select i18n/ui key
    repeat i length? args [replace out rejoin ["#" i] localize pick args i]
    out
]

digit: charset "0123456789"
word-char: charset [#"a" - #"z" #"A" - #"Z" #"0" - #"9" "._%+-"]
host-char: charset [#"a" - #"z" #"A" - #"Z" #"0" - #"9" "-"]
email-rule: [some word-char "@" some host-char some ["." some host-char] end]
url-rule: [["http://" | "https://"] some host-char any ["." some host-char] opt [":" some digit] opt ["/" to end] end]

; check and toggle hold true or false
logic-face?: func [f] [to logic! find [check toggle] f/style]

blank?: func [v] [
    any [none? :v  all [string? :v  empty? trim copy v]]
]

label-of: func [f] [either f/text [tr f/text] [form f/name]]

list-of: function [items [block!]] [
    out: copy ""
    foreach x items [unless empty? out [append out ", "] append out form x]
    out
]

; The message for the first rule a face breaks, or none. Asynchronous checks
; are skipped here: their last result is kept in async-error.
validate-face: function [
    "Checks a face's rules; returns a message or none."
    f
] [
    if f/readonly [return none]
    v: f/value
    rules: any [f/rules []]
    if f/style = 'rows [
        n: either v [length? v] [0]
        return case [
            all [n = 0  find/only rules [required]] [message 'required []]
            n < any [rule-of f 'min 0] [message 'rows-min reduce [rule-of f 'min]]
            n > any [rule-of f 'max n] [message 'rows-max reduce [rule-of f 'max]]
            true [none]
        ]
    ]
    if f/typed [
        if f/style = 'upload [return message 'accept reduce [list-of f/accept]]
        if f/style = 'photo [return either f/accept [message 'accept reduce [list-of f/accept]] [message 'images []]]
        return message select [number number money amount date date] f/style []
    ]
    if blank? :v [
        return either find/only rules [required] [message 'required []] [f/async-error]
    ]
    if all [logic-face? f  find/only rules [required]  not v] [return message 'required []]
    foreach r rules [
        problem: switch first r [
            email [unless parse v email-rule [message 'email []]]
            url [unless parse v url-rule [message 'url []]]
            integer [unless parse form v [opt "-" some digit] [message 'integer []]]
            min [if all [any [number? v  money? v  date? v]  v < r/2] [message 'min reduce [r/2]]]
            max [if all [any [number? v  money? v  date? v]  v > r/2] [message 'max reduce [r/2]]]
            length [
                n: length? form v
                if any [n < r/2  n > r/3] [
                    either r/2 = r/3 [message 'length-exact reduce [r/2]] [message 'length reduce [r/2 r/3]]
                ]
            ]
            pattern [unless parse form v r/2 [message 'pattern []]]
            match [
                other: find-named f r/2
                if all [other  v <> other/value] [message 'match reduce [label-of other]]
            ]
            check [check-result run-handler f r/2]
        ]
        if problem [return problem]
    ]
    f/async-error
]

check-result: func [result] [
    case [
        string? :result [result]
        any [none? :result  false = :result] [message 'check []]
        true [none]
    ]
]

find-named: function [f name] [
    scope: any [f/form f/root]
    foreach g named-faces scope [if g/name = name [return g]]
    none
]

; Runs asynchronous checks of a face (they may fetch).
check-async: function [f] [
    foreach r any [f/rules []] [
        if all [r/1 = 'check-async  not blank? f/value] [
            f/pending: true
            f/async-error: check-result run-handler f r/2
            f/pending: false
        ]
    ]
]

; Updates the errors of touched faces and enables submit buttons only when
; every field of the form is valid. A view checks only the faces outside its forms.
refresh-form: function [scope] [
    ; the fields of a row count for the form its rows are in
    while [all [scope  scope/style = 'entry]] [scope: any [scope/form scope/root]]
    unless all [scope  find [form view] scope/style] [exit]
    ok: true
    faces: own-faces scope
    foreach f faces [
        if any [f/rules  f/typed  f/error] [
            problem: validate-face f
            f/error: either f/touched [problem] [none]
            if problem [ok: false]
        ]
    ]
    foreach f faces [if f/submit [f/disabled: not ok]]
]

; --- events --------------------------------------------------------------------
;
; The host calls these from DOM events, each in its own task.

; A handler block runs with face, value, values and, as in Red, event bound;
; event is an object (event/key, event/away? ...) or none. Named fields are
; not bound: their values are in values, their faces reached through labels.
run-handler: function [f body [block!] /with ev [object!] /on node "row is this node, not the selected one" /given v "value is this, not the face's"] [
    scope: any [f/form f/root]
    ; /only: a value that is a block stays one block
    words: compose/only [
        face: (f)
        value: (quoted either given [:v] [f/value])
        values: (form-values any [scope f])
    ]
    if find data-styles f/style [append words compose [row: (either on [node] [f/selected])]]
    append words compose [event: (either with [ev] [none])]
    ctx: make object! words
    do bind copy/deep body ctx
]

; A value as it must appear in a block given to make object!
quoted: func [v] [
    case [
        word? :v [to lit-word! :v]
        path? :v [to lit-path! :v]
        true [:v]
    ]
]

handler-for: function [f name] [
    all [f/events  select f/events name]
]

ui-input: function [
    "Called by the host when the user changes a field."
    f new
] [
    f/value: switch/default f/style [
        number [any [attempt [to decimal! new]  none]]
        ; the host gives the amount as 1234.5, whatever the language
        money [all [new  attempt [to money! rejoin [any [f/currency ""] "$" new]]]]
        ; and a date as 2026-11-03
        date [all [new  attempt [to date! new]]]
        check [to logic! new]
        toggle [to logic! new]
    ] [new]
    if f/style = 'number [
        if all [decimal? f/value  f/value = to integer! f/value] [f/value: to integer! f/value]
    ]
    ; text that is not a number, amount or date stays on screen, with its message
    f/typed: all [find [number money date] f/style  new  none? f/value  new]
    changed f
]

changed: function [f] [
    f/async-error: none
    store-around f
    refresh-form any [f/form f/root]
    if f/action [run-handler f f/action]
    if h: handler-for f 'on-change [run-handler f h]
    if all [f/form  f/form/style = 'entry] [changed f/form/owner]
]

; An upload's value is none or a block of objects [name size type file];
; file is a handle the host keeps, read with read-file or sent with multipart.
; A photo's is none, the object of the image chosen, or the address of one kept elsewhere.
ui-files: function [
    "Called by the host when the user chooses or drops files: name size type file for each, and the names it refused."
    f files [block!] refused [block!]
] [
    chosen: collect [
        foreach [n s t h] files [keep make object! [name: n size: s type: t file: h]]
    ]
    unless empty? chosen [
        f/value: case [
            f/style = 'photo [first chosen]
            f/multiple [append copy any [f/value []] chosen]
            true [copy/part chosen 1]
        ]
    ]
    f/typed: either empty? refused [none] [refused]
    f/touched: true
    changed f
]

ui-remove-file: function [
    "Called by the host when the user removes the file at a position of an upload, or a photo's."
    f index [integer!]
] [
    f/value: either f/style = 'photo [none] [
        files: remove at copy f/value index
        either empty? head files [none] [head files]
    ]
    f/typed: none
    f/touched: true
    changed f
]

; A lookup's value is none, one value, or with `multiple` a block of them. Its on-search
; answers the options for event/query: maps with value and text, as a choice takes them.
ui-lookup-search: function [
    "Called by the host when the user opens a lookup or types in it."
    f text [string!]
] [
    f/query: text
    found: fire-event f 'on-search compose [query: (text)]
    ; the user may have typed on while this was answering
    if f/query = text [f/options: either block? :found [found] [copy []]]
]

ui-lookup-pick: function [
    "Called by the host when the user chooses an option of a lookup."
    f option [map!]
] [
    unless f/known [f/known: make map! []]
    poke f/known option/value option/text
    f/value: either f/multiple [
        any [
            all [f/value  find f/value option/value  f/value]
            append copy any [f/value []] option/value
        ]
    ] [option/value]
    changed f
]

ui-lookup-remove: function [
    "Called by the host when the user removes the value at a position of a multiple lookup."
    f index [integer!]
] [
    chosen: head remove at copy f/value index
    f/value: either empty? chosen [none] [chosen]
    changed f
]

ui-blur: function [
    "Called by the host when the user leaves a field."
    f
] [
    f/touched: true
    check-async f
    refresh-form any [f/form f/root]
]

ui-click: function [
    "Called by the host when the user activates a button."
    f
] [
    if f/submit [
        scope: any [f/form f/root]
        faces: own-faces scope
        foreach g faces [if g/rules [g/touched: true]]
        foreach g faces [check-async g]
        refresh-form scope
        if f/disabled [exit]
    ]
    if f/action [run-handler f f/action]
]

ui-select: function [
    "Called by the host when the user chooses a row of a table or list."
    f row
] [
    f/selected: row
    if h: handler-for f 'on-select [run-handler f h]
]

ui-sort: function [
    "Called by the host when the user chooses the header of a column of a table."
    f column [word!]
] [
    order: either all [block? f/sorted  f/sorted/1 = column  f/sorted/2 = 'asc] ['desc] ['asc]
    f/sorted: reduce [column order]
    fire-event f 'on-sort reduce [quote column: to lit-word! column  quote order: to lit-word! order]
]

ui-close: function [
    "Called by the host when the user dismisses a dialog."
    f
] [
    f/hidden: true
    if h: handler-for f 'on-close [run-handler f h]
]

; Runs the on-xxx handler of an event with event bound to an object made of
; type (the event name without on-) and the given [word: value ...] fields.
fire-event: function [f name [word!] fields [block!]] [
    if h: handler-for f name [
        type: to word! skip form name 3
        run-handler/with f h make object! append reduce [quote type: to lit-word! type] fields
    ]
]

ui-event: function [
    "Called by the host for on-focus, on-unfocus, on-over, on-dbl-click and on-key."
    f name [word!] fields [block!]
] [
    fire-event f name fields
]

ui-crumb: function [
    "Called by the host when the user chooses an item of a breadcrumb."
    f item [word! path!]
] [
    f/value: item
    if f/action [run-handler f f/action]
]

ui-menu: function [
    "Called by the host when the user chooses a menu item; row is the row it was opened on."
    f item row
] [
    if row [f/selected: row]
    fire-event f 'on-menu reduce [quote picked: quoted item/id]
]

ui-drop: function [
    "Called by the host when something is dropped on a face; index is where it goes (1-based), parent the tree node."
    f dropped source index [integer!] parent
] [
    fields: reduce [quote dropped: quoted :dropped  quote source: source  quote index: index]
    if f/style = 'tree [append fields reduce [quote parent: parent]]
    fire-event f 'on-drop fields
]

ui-reorder: function [
    "Called by the host when the user moves a child or row of a face; in a tree, among the children of parent."
    f from [integer!] to [integer!] parent
] [
    fields: reduce [quote from: from  quote to: to]
    case [
        f/style = 'tree [
            either parent [parent/children: move-item parent/children from to] [f/data: move-item f/data from to]
            f/data: f/data      ; repaint the tree
            append fields reduce [quote parent: parent]
        ]
        find data-styles f/style [f/data: move-item f/data from to]
        true [f/pane: move-item f/pane from to]
    ]
    fire-event f 'on-reorder fields
]

ui-orbit: function [
    "Called by the host when the user picks a node of an orbit: a neighbour, or one of the trail when back is true."
    f id back [logic!]
] [
    f/value: id
    ; with no on-back, stepping back is one more pick
    either all [back  handler-for f 'on-back] [fire-event f 'on-back []] [if f/action [run-handler f f/action]]
]

ui-expand: function [
    "Called by the host when the user opens a node of a tree."
    f node
] [
    if h: handler-for f 'on-expand [
        run-handler/with/on f h make object! [type: 'expand] node
    ]
]

move-item: function [items [block!] from [integer!] to [integer!]] [
    items: copy items
    x: pick items from
    remove at items from
    insert/only at items to :x
    items
]
