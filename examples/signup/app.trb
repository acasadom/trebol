Trebol [title: "Sign up"]

taken: ["admin" "root" "ana"]

view [
    title "Create your account"
    text muted "It takes less than a minute. We never share your email."
    sign-up: panel [
        form [
            field name "Full name" "Ada Lovelace" required
            field email "Email" "you@example.com" required email
            field user "Username" required length 3 20 check-async [
                wait 0.4
                either find taken value ["That username is taken"] [true]
            ]
            number age "Age" min 18
            password pass "Password" "At least 8 characters" required length 8 64
            password pass2 "Repeat password" match pass
            check terms "I accept the terms and the privacy policy" required
            submit "Create account" [
                sign-up/hidden: true
                done/text: rejoin ["Welcome, " values/name "! Your account is ready."]
                done/hidden: false
            ]
        ]
    ]
    done: text success hidden
]
