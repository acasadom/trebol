Trebol [title: "Gallery"]

; Every component of the UI dialect on one page, in any look.

view compose/deep/only [
    title "Gallery"
    text muted "Every component of the UI dialect, with no HTML or CSS."
    row [
        button #settings "Look" menu (looks) on-menu [look: event/picked retheme]
        button "Mode" menu ["Light" light "Dark" dark "Auto" auto] on-menu [mode: event/picked retheme]
        button "Dialog" [open edit]
        button "Confirm" [
            either confirm/role "Delete the draft?" 'danger [toast/role "Deleted" 'danger] [toast "Kept"]
        ]
    ]
    global edit: dialog "Edit client" [
        form [
            field name "Name" required
            choice kind "Kind" ["Person" "Company"]
            submit "Save" [close edit toast/role "Saved" 'success]
        ]
    ]
    people-pane: split [
        global list people [name "Name" job "Job"] on-select [
            person/text: row/name
            about/text: row/about
            people-pane/value: 2
        ]
        panel [
            person: heading "Choose someone"
            about: text muted "Their details show here. On a narrow screen this pane replaces the list."
        ]
    ]
    panel "Navigation" [
        crumbs: breadcrumb ["Home" home "Clients" clients "Companies" companies "Acme" acme "Invoices"] [
            toast rejoin ["Go to " value]
        ]
        toolbar "Document" [
            button #plus "New" [toast "New"]
            button #edit "Edit" [toast "Edit"]
            ---
            button #trash "Delete" [toast/role "Deleted" 'danger]
            button #settings "Settings" menu ["Theme" theme "Language" language] on-menu [toast form event/picked]
        ]
    ]
    panel "Table" [
        global table invoices [number "Invoice" client "Client" due "Due" amount "Amount"] sortable sorted [due asc]
    ]
    panel "Tree" [
        global files: tree [name] reorder on-select [toast row/name] on-expand [
            if empty? row/children [
                row/children: reduce [make map! [id 99 name "Loaded when opened"]]
                files/data: files/data
            ]
        ]
    ]
    panel "Inputs" [
        form [
            field #search "Search" "Name or email"
            field name "Name" required
            password secret "Password"
            lookup client "Client" on-search [
                collect [
                    foreach p people/data [if find p/name event/query [keep make map! reduce ['value p/id 'text p/name]]]
                ]
            ]
            choice kind "Kind" ["Person" "Company"]
            money price "Price" EUR min 0
            date due "Due date" min 1-Nov-2026
            upload docs "Attachments" multiple accept ["pdf" "png"]
            radio size "Size" ["Small" "Medium" "Large"] required
            toggle alerts "Email alerts"
            area notes "Notes"
            global story: rich about "About"
            rows lines "Lines" min 1 [field part "Part" number qty "Qty"]
            check terms "I accept the terms" required
            submit "Save" [toast/role "Saved" 'success]
            button "Reset" [set-values face/form none]
        ]
    ]
    panel "Tabs" [
        tabs [
            "General" [field "Company" "Acme" check "Active"]
            "Billing" [money "Credit" EUR text muted "Paid by transfer."]
        ]
    ]
    panel "Progress" [
        upload: progress "Uploading photos" 40%
        progress "Waiting for the server"
        row [
            button #minus "Less" [upload/value: max 0% upload/value - 10%]
            button #plus "More" [upload/value: min 100% upload/value + 10%]
        ]
    ]
    panel "Layout" [
        text muted narrow-only "You are on a narrow screen."
        text muted wide-only "You are on a wide screen."
        row gap 1 [button "Tight" button "Row" button "Gap 1"]
        divider
        row [
            column [text "A column" text muted "one under another"]
            column [text "Another" text muted "beside it"]
        ]
        log: scroll small "Activity" pad 3 [
            text "Ada signed in"
            text "Grace added a client"
            text "Linus exported the list"
            text "Margaret changed the theme"
            text "Alan deleted a draft"
            text "Barbara invited Ken"
            text "Ken accepted the invitation"
            text "Dennis updated his phone"
        ]
    ]
    panel "Drawing" [
        row [
            canvas 120x120 "A wheel" [
                pen text line-width 4 fill-pen surface circle 60x60 52
                line-width 2 pen muted
                line 60x8 60x112 line 8x60 112x60 line 23x23 97x97 line 97x23 23x97
                pen primary fill-pen primary circle 60x60 10
            ]
            canvas 160x120 "Shapes" [
                fill-pen orange box 10x10 70x50 6
                fill-pen teal triangle 90x50 150x50 120x10
                pen purple line-width 3 fill-pen off arc 40x90 25x25 180 180
                pen red curve 90x110 120x60 150x110
            ]
        ]
    ]
    panel "Image" [
        image %wheel.svg "A bicycle wheel" small
    ]
    panel "Backdrop" [
        backdrop %workshop.svg
        heading "Open every day"
        text muted "The theme veils the image so this text reads well on it."
    ]
    panel "Charts" [
        global chart bar income "Income by month" [month "Month" repairs "Repairs" parts "Parts"]
        grid 2 [
            global chart line visits small "Bikes in" [day "Day" bikes "Bikes"]
            global chart pie jobs small "Jobs" [job "Job" count "Count"]
        ]
    ]
    panel "Desktop" [
        desktop menu ["New folder" new] on-menu [toast "New folder"] [
            tile #folder "Reports" [toast "Reports"]
            tile #user "Clients" [toast "Clients"]
            tile #folder "Archive" linked [toast "Archive"]
        ]
    ]
    panel "Icons" [
        row [
            icon #home icon #user icon #mail primary icon #star accent
            icon #heart danger icon #check success icon #warning warning icon #info muted
        ]
        row [
            button primary #plus "New client"
            button #edit "Edit"
            button danger #trash "Delete"
            button #settings
            link #external "Trebol on the web" https://example.com
        ]
    ]
]

story/value: "Fixes **brakes** and *gears*."

look: 'minimal
mode: 'auto
retheme: does [theme compose [look: (look) mode: (mode)]]

people/data: [
    #(id: 1 name: "Ada Lovelace" job: "Analyst" about: "Wrote the first program for the Analytical Engine.")
    #(id: 2 name: "Grace Hopper" job: "Admiral" about: "Built the first compiler and popularised COBOL.")
    #(id: 3 name: "Alan Turing" job: "Mathematician" about: "Defined computability with the Turing machine.")
]

invoices/data: [
    #(id: 1 number: "F-2026-014" client: "Zoe Martin" due: 12-Nov-2026 amount: EUR$1200.00)
    #(id: 2 number: "F-2026-009" client: "Álvaro Ruiz" due: 3-Nov-2026 amount: EUR$85.50)
    #(id: 3 number: "F-2026-021" client: "ana Pérez" amount: EUR$430.00)
    #(id: 4 number: "F-2026-002" client: "Bruno Díaz" due: 28-Oct-2026 amount: EUR$2310.75)
]
total: EUR$0
foreach row invoices/data [total: total + row/amount]
invoices/totals: make map! reduce ['number "Total" 'amount total]

node: function [id name kids] [
    n: make map! reduce ['id id 'name name]
    if kids [n/children: kids]
    n
]
files/data: reduce [
    node 1 "Documents" reduce [
        node 2 "Invoices" reduce [node 3 "2026-01.pdf" none node 4 "2026-02.pdf" none]
        node 5 "Contracts" reduce [node 6 "Lease.pdf" none]
        node 7 "Notes.txt" none
    ]
    node 8 "Photos" copy []
    node 9 "Readme.md" none
]
files/data/1/expanded: true

income/data: [
    #(month: "Jul" repairs: EUR$1200.00 parts: EUR$340.00)
    #(month: "Aug" repairs: EUR$1450.00 parts: EUR$410.00)
    #(month: "Sep" repairs: EUR$1620.00 parts: EUR$380.00)
    #(month: "Oct" repairs: EUR$1380.00 parts: EUR$520.00)
]
visits/data: [
    #(day: "Mon" bikes: 6) #(day: "Tue" bikes: 9) #(day: "Wed" bikes: 4)
    #(day: "Thu" bikes: 11) #(day: "Fri" bikes: 8)
]
jobs/data: [
    #(job: "Brakes" count: 14) #(job: "Chains" count: 9) #(job: "Wheels" count: 6) #(job: "Other" count: 3)
]
