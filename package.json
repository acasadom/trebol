{
  "name": "trebol",
  "version": "0.8.5",
  "description": "Trebol: a Rebol-derived language for building beautiful web UIs without HTML or CSS",
  "keywords": [
    "rebol",
    "language",
    "interpreter",
    "ui",
    "web"
  ],
  "homepage": "https://trebol-lang.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acasadom/trebol.git"
  },
  "type": "module",
  "exports": {
    "./core": {
      "types": "./dist/lib/core/index.d.ts",
      "source": "./src/core/index.ts",
      "default": "./dist/lib/core/index.js"
    },
    "./host": {
      "types": "./dist/lib/host/index.d.ts",
      "source": "./src/host/index.ts",
      "default": "./dist/lib/host/index.js"
    },
    "./browser": {
      "types": "./dist/lib/host/browser.d.ts",
      "source": "./src/host/browser.ts",
      "default": "./dist/lib/host/browser.js"
    }
  },
  "bin": {
    "trebol": "dist/cli.js"
  },
  "license": "Apache-2.0",
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md",
    "editors/vscode"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "readme-shot": "node --disable-warning=ExperimentalWarning tools/readme-shot.ts",
    "test:browser": "node --disable-warning=ExperimentalWarning --test \"test/browser/*.browser.ts\"",
    "build": "node --disable-warning=ExperimentalWarning tools/build.ts",
    "prepack": "npm run build",
    "mold": "node tools/mold.ts",
    "trb": "node --disable-warning=ExperimentalWarning tools/cli.ts",
    "dev": "node tools/cli.ts dev --api examples/api.ts",
    "bench": "node --disable-warning=ExperimentalWarning tools/cli.ts tools/bench.trb",
    "reference": "node --disable-warning=ExperimentalWarning tools/reference.ts",
    "r3check": "node --disable-warning=ExperimentalWarning tools/r3check.ts",
    "supplier": "node --disable-warning=ExperimentalWarning tools/cli.ts supplier",
    "docs:serve": "npm run docs && node --disable-warning=ExperimentalWarning tools/cli.ts dev docs/_build/html --port 8000",
    "site": "npm run docs && node --disable-warning=ExperimentalWarning tools/web.ts",
    "site:serve": "npm run site && node --disable-warning=ExperimentalWarning tools/cli.ts dev _site --port 8000",
    "docs": "uv run --quiet --no-project --with-requirements docs/requirements.txt sphinx-build -q -E -b html docs docs/_build/html",
    "grammar": "node --disable-warning=ExperimentalWarning tools/grammar.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "playwright": "^1.65.1",
    "typescript": "^5.9.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2",
    "ws": "^8.23.0"
  }
}
