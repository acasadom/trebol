{
  "name": "trebol",
  "version": "0.0.1",
  "description": "Trebol: a Rebol-derived language for building beautiful web UIs without HTML or CSS",
  "type": "module",
  "exports": {
    "./core": "./src/core/index.ts",
    "./host": "./src/host/index.ts",
    "./browser": "./src/host/browser.ts"
  },
  "bin": {
    "trebol": "./tools/cli.ts"
  },
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "mold": "node tools/mold.ts",
    "trb": "node --disable-warning=ExperimentalWarning tools/cli.ts",
    "dev": "node tools/cli.ts dev --api examples/api.ts",
    "bench": "node --disable-warning=ExperimentalWarning tools/cli.ts tools/bench.trb",
    "reference": "node --disable-warning=ExperimentalWarning tools/reference.ts",
    "r3check": "node --disable-warning=ExperimentalWarning tools/r3check.ts",
    "supplier": "node --disable-warning=ExperimentalWarning examples/supplier.ts",
    "docs:serve": "npm run docs && node --disable-warning=ExperimentalWarning tools/cli.ts dev docs/_build/html --port 8000",
    "docs": "uv run --quiet --no-project --with-requirements docs/requirements.txt sphinx-build -q -E -b html docs docs/_build/html"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.0"
  }
}
